# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Database dumps & backup artefacts — NEVER commit. A dump is the ENTIRE payroll
# database in plaintext, so committing one is strictly worse than leaking the
# credential that protects it. docs/MIGRATION_SLIPLANE.md and
# scripts/restore-from-backup.md both instruct `pg_dump -f payroll.dump` with the
# repo as the working directory, so these land in the tree by default.
# NOTE: deliberately NOT *.sql — prisma/migrations/**/migration.sql is tracked.
*.dump
*.sql.gz
*.sql.zst
*.sql.bz2
*.gpg
*.bak

# Credential-shaped files
.pgpass
*.key
*.p12
*.pfx
id_rsa*
secrets.json
credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local dev cache & virtualenv (never commit)
/tmp/
/.venv/

# Claude Code local state (worktrees, local permission overrides)
.claude/
