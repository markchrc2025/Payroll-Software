  employeeId    String
  type          ConsentType
  granted       Boolean
  /// Free-text policy/version identifier shown at consent time (e.g. "v2026-01").
  policyVersion String
  ipAddress     String?
  userAgent     String?

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId, type])
}

// =============================================================================
// AI USAGE METERING
// =============================================================================

model AiUsage {
  id           String       @id @default(cuid())
  tenantId     String
  userId       String?
  touchpoint   AiTouchpoint
  model        String // e.g. "claude-haiku-4.5"
  inputTokens  Int          @default(0)
  outputTokens Int          @default(0)
  /// Cached input tokens (Anthropic prompt caching). Subset of inputTokens.
  cachedTokens Int          @default(0)
  /// Cost in micro-USD (1 USD = 1_000_000) to keep integer arithmetic.
  costMicroUsd BigInt       @default(0)
  latencyMs    Int?

  /// Free-form correlation key (request id, payroll run id, etc.)
  refKey String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, touchpoint])
}

// =============================================================================
// STATUTORY CONFIGURATION ENGINE (Phase D1)
//
// Effective-dated rule store. One row per (category, version, optional tenant).
// `tenantId IS NULL` rows are the global baseline (BIR/SSS/PhilHealth/HDMF
// published values). Non-null rows are per-tenant overrides — currently only
// DE_MINIMIS_CEILING and MINIMUM_WAGE_RATE accept overrides via the app layer
// (`MINIMUM_WAGE_RATE` overrides below the global floor are hard-rejected at
// the route boundary).
//
// `payload` is a JSON blob whose shape is enforced by zod schemas in
// `src/lib/statutory/types.ts`. The resolver in `src/lib/statutory/resolver.ts`
// always prefers a tenant-scoped row when one is active for the asOf date.
//
// RLS: see migration `20260527090000_d1_statutory_rules`. Reads allow
// `tenantId IS NULL OR tenantId = current_setting(...)`. Writes require
// `tenantId = current_setting(...)` (global rows are owner-only, loaded via
// the seed script running as the migration superuser).
// =============================================================================

model StatutoryRule {
  id            String            @id @default(cuid())
  /// NULL = global default; non-null = tenant override.
  tenantId      String?
  category      StatutoryCategory
  /// Inclusive lower bound. Rule is active for asOfDate >= effectiveFrom.
  effectiveFrom DateTime
  /// Exclusive upper bound. NULL = open-ended.
  effectiveTo   DateTime?
  /// Citation of the legal basis (e.g. "RA 11199 + SSS Circular 2025-006").
  legalBasis    String
  /// Human/script-readable version tag (e.g. "SSS-2026-v1", "TRAIN-2023-onward-v1").
  version       String
  /// Polymorphic payload — shape per category enforced by zod at runtime.
  payload       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  /// One row per (tenantOrGlobal, category, version). Tenant overrides and
  /// global rules can coexist; resolver picks tenant first.
  @@unique([tenantId, category, version])
  @@index([category, effectiveFrom])
  @@index([tenantId, category, effectiveFrom])
}

// =============================================================================
// PAY COMPONENT CATALOG (Phase D2)
//
// Tenant-scoped catalog of recurring or ad-hoc earnings & deductions consumed
// by the gross-to-net engine. The catalog does NOT include statutory
// contributions (SSS / PhilHealth / Pag-IBIG / BIR) — those are computed by
// the engine using `StatutoryRule` rows.
// =============================================================================

model PayComponent {
  id       String @id @default(cuid())
  tenantId String

  /// Stable short code, e.g. "RICE", "MEAL", "BONUS_PERFY". Unique per tenant.
  code          String
  /// Human-facing display name.
  name          String
  kind          PayComponentKind
  taxability    PayComponentTaxability @default(TAXABLE)
  /// Required iff `taxability = DE_MINIMIS`. Must match a code in the active
  /// `DE_MINIMIS_CEILING` payload at compute time.
  deMinimisCode String?

  /// Whether amount counts toward the 13th-month-pay basis.
  includeIn13thMonth      Boolean @default(false)
  /// Whether amount counts toward the SSS / PhilHealth / Pag-IBIG MSC bases.
  /// Government rules currently treat MSC bases identically (basic + regular
  /// allowances); the flag is split per fund to allow future drift.
  includeInSssBase        Boolean @default(false)
  includeInPhilHealthBase Boolean @default(false)
  includeInPagibigBase    Boolean @default(false)

  /// PAY-171 (Mark, 17 and 19 Nov 2026): a bonus (14th month, 15th month,
  /// incentives, any company bonus). Counts with the 13th month toward the
  /// year's 90,000 exemption for "13th month and other benefits"; the excess
  /// is taxed at the employee's rate for the year, not through the period's
  /// table. Nothing is seeded: each company ticks its own components.
  isBonus  Boolean @default(false)
  /// PAY-171: one-off taxable pay (leave conversion, a one-time incentive that
  /// is not a bonus): taxed at the employee's rate for the year instead of
  /// through the period's table, as on Mark's Smart payslips (finding 2).
  isOneOff Boolean @default(false)

  /// PAY-149: seeded by Sentire (Inventory Deduction); cannot be deleted and
  /// keeps its kind.
  isSystem       Boolean @default(false)
  /// PAY-149: a loss or damage deduction (Labor Code Art. 114, 115), DEDUCTION
  /// kind only. Its guardrails are PAY-150.
  isLossOrDamage Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  assignments EmployeePayComponent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([deletedAt])
}

/// Effective-dated assignment of a `PayComponent` to an `Employee` with an
/// amount expressed in centavos. The engine resolves the active assignment
/// for a given period by `effectiveFrom <= periodEnd AND (endDate IS NULL OR
/// endDate >= periodStart)`.
model EmployeePayComponent {
  id             String @id @default(cuid())
  tenantId       String
  employeeId     String
  payComponentId String

  /// Amount in centavos. For recurring components this is the per-pay-period
  /// amount; the engine pro-rates by `daysWorked` only when the component is
  /// marked as basic-pay-proportional (deferred — for now amounts are flat).
  amountCents BigInt

  effectiveFrom DateTime
  /// Inclusive upper bound. NULL = open-ended.
  endDate       DateTime?

  notes String?

  /// PAY-150: the employee's written authorization for an Other Deduction
  /// (date signed and the uploaded copy). The run refuses the deduction
  /// without both.
  authorizationDate    DateTime?
  authorizationFileKey String?
  /// PAY-150, loss or damage deductions: the incident record showing the
  /// employee was heard, and the actual loss (the most that may be recovered).
  incidentReportId     String?
  actualLossCents      BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  payComponent PayComponent @relation(fields: [payComponentId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([employeeId, payComponentId, effectiveFrom])
}

// =============================================================================
// PERIOD INPUTS (Phase D2)
//
// Captures engine inputs for ONE employee for ONE pay period. Created either
// (a) manually by HR/payroll for shops without DTR ingestion, or (b) populated
// from approved DTRs in a later phase. One row per (employee, periodStart,
// periodEnd).
//
// Time fields are stored as Decimal(10,4); the engine multiplies against the
// employee's hourly rate (in centavos) and uses BigInt arithmetic to land on
// centavos.
// =============================================================================

model PeriodInput {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  periodStart DateTime
  periodEnd   DateTime

  /// Actual days rendered in the period. Fractional days allowed (half-days,
  /// suspended ops). Defaults to 0 — caller MUST set explicitly.
  daysWorked           Decimal @default(0) @db.Decimal(6, 2)
  /// Aggregate tardiness + undertime in minutes.
  lateUndertimeMinutes Int     @default(0)

  regularOtHours      Decimal @default(0) @db.Decimal(6, 2)
  restDayHours        Decimal @default(0) @db.Decimal(6, 2)
  specialHolidayHours Decimal @default(0) @db.Decimal(6, 2)
  regularHolidayHours Decimal @default(0) @db.Decimal(6, 2)
  nightDiffHours      Decimal @default(0) @db.Decimal(6, 2)
  hazardHours         Decimal @default(0) @db.Decimal(6, 2)

  unpaidLeaveDays Decimal @default(0) @db.Decimal(6, 2)

  /// Full rest-day worked: daily-rate-based (one entry per full day off-duty worked).
  dayOffDutyDays Decimal @default(0) @db.Decimal(6, 2)

  // ─── OT extensions (already in types.ts, now persisted) ───────────────────
  restDayOtHours        Decimal @default(0) @db.Decimal(6, 2)
  specialHolidayOtHours Decimal @default(0) @db.Decimal(6, 2)
  regularHolidayOtHours Decimal @default(0) @db.Decimal(6, 2)
  doubleHolidayHours    Decimal @default(0) @db.Decimal(6, 2)
  doubleHolidayOtHours  Decimal @default(0) @db.Decimal(6, 2)

  // ─── No-work holiday (already in types.ts, now persisted) ─────────────────
  noWorkRegularHolidayDays Decimal @default(0) @db.Decimal(6, 2)

  // ─── Rest-day + holiday compound scenarios ────────────────────────────────
  restDaySpecialHolidayHours   Decimal @default(0) @db.Decimal(6, 2) // 1.50×
  restDaySpecialHolidayOtHours Decimal @default(0) @db.Decimal(6, 2) // 1.95×
  restDayRegularHolidayHours   Decimal @default(0) @db.Decimal(6, 2) // 2.60×
  restDayRegularHolidayOtHours Decimal @default(0) @db.Decimal(6, 2) // 3.38×
  restDayDoubleHolidayHours    Decimal @default(0) @db.Decimal(6, 2) // 3.90×
  restDayDoubleHolidayOtHours  Decimal @default(0) @db.Decimal(6, 2) // 5.07×

  // ─── NSD differential hours (already partially in types.ts) ───────────────
  nightDiffOtHours                      Decimal @default(0) @db.Decimal(6, 2)
  nightDiffRestDayHours                 Decimal @default(0) @db.Decimal(6, 2)
  nightDiffRestDayOtHours               Decimal @default(0) @db.Decimal(6, 2)
  nightDiffSpecialHolidayHours          Decimal @default(0) @db.Decimal(6, 2)
  nightDiffSpecialHolidayOtHours        Decimal @default(0) @db.Decimal(6, 2)
  nightDiffSpecialHolidayRestDayHours   Decimal @default(0) @db.Decimal(6, 2)
  nightDiffSpecialHolidayRestDayOtHours Decimal @default(0) @db.Decimal(6, 2)
  nightDiffRegularHolidayHours          Decimal @default(0) @db.Decimal(6, 2)
  nightDiffRegularHolidayOtHours        Decimal @default(0) @db.Decimal(6, 2)
  nightDiffRegularHolidayRestDayHours   Decimal @default(0) @db.Decimal(6, 2)
  nightDiffRegularHolidayRestDayOtHours Decimal @default(0) @db.Decimal(6, 2)
  nightDiffDoubleHolidayHours           Decimal @default(0) @db.Decimal(6, 2)
  nightDiffDoubleHolidayOtHours         Decimal @default(0) @db.Decimal(6, 2)
  nightDiffDoubleHolidayRestDayHours    Decimal @default(0) @db.Decimal(6, 2)
  nightDiffDoubleHolidayRestDayOtHours  Decimal @default(0) @db.Decimal(6, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
  @@index([employeeId, periodStart])
}

// =============================================================================
// LOANS (Phase D2)
//
// Government (SSS / Pag-IBIG) or in-house loans. The engine deducts
// `installmentCents` from net pay per active loan and decrements `balanceCents`
// after each successful payroll run (deferred to D3 finalize).
// =============================================================================

model Loan {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  loanType        LoanType
  /// External reference (SSS loan number, contract number, etc.).
  referenceNumber String?

  principalCents   BigInt
  installmentCents BigInt
  balanceCents     BigInt

  status LoanStatus @default(ACTIVE)

  startDate  DateTime
  /// Date the loan was fully paid / cancelled. Engine-set on terminal
  /// transitions.
  closedDate DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, status])
}

// =============================================================================
// PAYROLL RUN — PayrollBook + PayrollSheet (Phase D3)
//
// A `PayrollBook` represents one payroll run for a tenant × period × runType.
// While `status = DRAFT`, sheets can be recomputed (delete-and-regenerate).
// On `FINALIZED`, the book is immutable: loan balances are decremented and an
// `AuditLog` entry is written in the same tx. Corrections after finalize use
// off-cycle runs (`runType = OFF_CYCLE`), never in-place edits.
// =============================================================================

model PayrollBook {
  id       String @id @default(cuid())
  tenantId String

  periodStart DateTime
  periodEnd   DateTime
  cycle       PayFrequency
  runType     PayrollRunType    @default(REGULAR)
  status      PayrollBookStatus @default(DRAFT)

  notes String?

  /// When true the engine skips SSS/PhilHealth/Pag-IBIG deductions for every
  /// sheet in this run (WHT is still computed).  Primarily for OFF_CYCLE
  /// bonus runs where statutory was already collected in the regular cycle.
  skipStatutory Boolean @default(false)

  /// Only set for FINAL_PAY runs.  Drives DOLE separation-pay formula and
  /// BIR taxability; preserved on the book so recomputeRun is idempotent.
  separationReason SeparationReason?

  /// PAY-135: the employees this run is limited to (an OFF_CYCLE, FINAL_PAY
  /// or YEAR_END subset). Stored on the book so the background compute
  /// (processRun) and recomputeRun select exactly the people the run was
  /// created for. Empty = every employee the run type selects.
  targetEmployeeIds String[] @default([])

  /// PAY-171 (Mark, 17 Nov 2026): this REGULAR run also pays the 13th month on
  /// the regular payslip (HR ticks it, for example for the 15 December payday).
  includeThirteenthMonth Boolean @default(false)

  /// PAY-172: employees who need a time clock and lacked an approved DTR for
  /// days of this run's cutoff, as [{ employeeId, days, held, notifiedAt? }].
  /// held = left out of the run (strict DTR policy); otherwise the days were
  /// counted as absent. Shown on the run page; HR and each employee's
  /// immediate supervisor are emailed once per employee.
  dtrGaps Json?

  /// PAY-141: the day people are paid (moved back off Sundays and holidays)
  /// and the DTR cutoff window whose attendance this run uses. Set when the
  /// run is created from a payday; NULL on runs typed by date (older runs,
  /// off-cycle), which use periodStart..periodEnd for attendance as before.
  payDate     DateTime?
  cutoffStart DateTime?
  cutoffEnd   DateTime?

  createdByUserId   String?
  finalizedAt       DateTime?
  finalizedByUserId String?
  /// PAY-69: document control number, issued gapless at finalize (PR-YYYY-NNNN). Never changes once set.
  controlNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  sheets            PayrollSheet[]
  adjustments       PayrollAdjustment[]
  expenseClaims     ExpenseClaim[]      @relation("BookExpenseClaims")
  paidExpenseClaims ExpenseClaim[]      @relation("BookPaidExpenseClaims")
  landedCorrections PayrollCorrection[] @relation("CorrectionTarget")

  @@unique([tenantId, periodStart, periodEnd, runType])
  @@unique([tenantId, controlNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, periodEnd])
}

/// PAY-141: paydays and the DTR cutoff window feeding each payday, for a pay
/// cycle that has a schedule (SEMI_MONTHLY: two slots; MONTHLY: one). WEEKLY
/// (Saturday, Saturday-to-Friday cutoff) and DAILY are fixed and have no row.
/// No row for a cycle: the default (15th and month-end, cutoff = pay period).
/// Days are 1 to 31; 30 and 31 mean the last day of the month.
model PaySchedule {
  id       String       @id @default(cuid())
  tenantId String
  cycle    PayFrequency

  payDay1         Int
  cutoff1StartDay Int
  cutoff1EndDay   Int
  payDay2         Int?
  cutoff2StartDay Int?
  cutoff2EndDay   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, cycle])
}

/// PAY-144 (Mark, 16 Nov 2026, HR.my review D4 = C): year-to-date figures an
/// employee brings into Sentire for one calendar year, so a company that joins
/// mid-year pays the right 13th month and withholds the right year-end tax.
/// One row per employee, year and source. Amounts in centavos. Locked once the
/// employee has a FINALIZED YEAR_END or FINAL_PAY run in that year (the run
/// keeps a copy of what it used in periodInputSnapshot.ytdOpening).
model EmployeeYtdOpening {
  id         String           @id @default(cuid())
  tenantId   String
  employeeId String
  year       Int
  source     YtdOpeningSource

  /// PREVIOUS_EMPLOYER only: the employer named on its 2316.
  previousEmployerName String?
  previousEmployerTin  String?

  /// PRIOR_PAYROLL only (0 for PREVIOUS_EMPLOYER): basic pay earned in the
  /// year before Sentire (13th month base) and 13th month already paid.
  basicPayEarnedCents      BigInt @default(0)
  thirteenthMonthPaidCents BigInt @default(0)

  /// Both sources: taxable compensation, tax withheld, and the non-taxable
  /// 13th month and other benefits (the 90,000 exemption already used).
  taxableCompensationCents          BigInt @default(0)
  withholdingTaxCents               BigInt @default(0)
  nontaxable13MonthAndBenefitsCents BigInt @default(0)

  /// PRIOR_PAYROLL only: the other non-taxable lines of the 2316.
  sssEeCents           BigInt @default(0)
  philhealthEeCents    BigInt @default(0)
  pagibigEeCents       BigInt @default(0)
  otherNontaxableCents BigInt @default(0)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, year, source])
  @@index([tenantId, year])
}

/// One frozen pay-stub computation per employee per run. All monetary fields
/// are BigInt centavos. Snapshot fields capture the inputs used so the row
/// remains explainable even if the underlying master data changes later.
model PayrollSheet {
  id            String @id @default(cuid())
  tenantId      String
  payrollBookId String
  employeeId    String

  // -- Snapshots (master data captured at compute time) ---------------------
  taxClassificationSnapshot      TaxClassification
  /// Region code from the employee's branch.workLocation at compute time.
  regionSnapshot                 String?
  payFrequencySnapshot           PayFrequency
  salaryTypeSnapshot             SalaryType
  basicSalaryCentsSnapshot       BigInt
  workingDaysDenominatorSnapshot Int
  /// Whether statutory contributions were deducted in this run (driven by
  /// tenant's `statutoryCutoffRule` and the period's position in the month).
  statutoryDeductedSnapshot      Boolean

  // -- Step 1: Base pay (after late/undertime) ------------------------------
  basePayCents                BigInt @default(0)
  lateUndertimeDeductionCents BigInt @default(0)

  // -- Step 3: Premium pay (broken out for payslip readability) -------------
  otPayCents      BigInt @default(0)
  nsdPayCents     BigInt @default(0)
  holidayPayCents BigInt @default(0)
  hazardPayCents  BigInt @default(0)
  restDayPayCents BigInt @default(0)

  // -- Step 4: Pay components -----------------------------------------------
  taxableAllowancesCents BigInt @default(0)

  // -- Step 5/6: Gross + non-taxable buckets --------------------------------
  grossCompensationCents            BigInt @default(0)
  mweExemptCompensationCents        BigInt @default(0)
  nontaxableBasicCents              BigInt @default(0)
  nontaxableCompensationCents       BigInt @default(0)
  nontaxable13MonthAndBenefitsCents BigInt @default(0)

  // -- Step 7: Taxable -------------------------------------------------------
  grossTaxableIncomeCents BigInt @default(0)

  // -- Step 8: Statutory contributions --------------------------------------
  sssEeCents        BigInt @default(0)
  sssErCents        BigInt @default(0)
  sssEcCents        BigInt @default(0)
  philhealthEeCents BigInt @default(0)
  philhealthErCents BigInt @default(0)
  pagibigEeCents    BigInt @default(0)
  pagibigErCents    BigInt @default(0)

  // -- Step 9: Withholding tax ----------------------------------------------
  withholdingTaxCents BigInt @default(0)

  // -- Step 10/11: Add-backs and deductions ---------------------------------
  nontaxableAdditionsCents  BigInt @default(0)
  loanDeductionsCents       BigInt @default(0)
  /// Loan installment scheduled this period but DEFERRED by the "no negative
  /// pay" floor (carried forward in the loan balance). 0 when nothing was
  /// deferred. Lets the payslip show that amortisation was paused this period.
  loanDeferredCents         BigInt @default(0)
  /// DEDUCTION-kind payroll adjustments applied this run (subtracted from net).
  adjustmentDeductionsCents BigInt @default(0)

  // -- Step 12: Final --------------------------------------------------------
  netPayCents BigInt @default(0)

  // -- Polymorphic breakdowns for payslip / audit ---------------------------
  /// Array of { id, code, name, kind, taxability, amountCents }.
  payComponentsApplied     Json  @default("[]")
  /// Array of { loanId, type, amountCents, balanceBeforeCents, balanceAfterCents }.
  /// Populated at compute; `balanceAfterCents` only authoritative once the run
  /// is FINALIZED (engine debits the loan during finalize tx).
  loanPaymentsApplied      Json  @default("[]")
  /// Snapshot of the PeriodInput row used (days/hours/minutes).
  periodInputSnapshot      Json  @default("{}")
  /// Per-fund SSS/PhilHealth/Pag-IBIG raw breakdown (msc, regular, mpf, ec).
  statutoryBreakdown       Json  @default("{}")
  /// PAY-59 (R59): the version of each statutory table that priced this
  /// payslip: category to { id, version, effectiveFrom, legalBasis }. Null on
  /// payslips computed before PAY-59.
  statutoryRuleVersions    Json?
  /// FINAL_PAY-only: back pay, prorated 13th, leave cash-out, separation pay,
  /// annualization inputs/outputs.  Null for REGULAR / OFF_CYCLE / YEAR_END.
  finalPayBreakdown        Json?
  /// PAY-168: how a YEAR_END sheet's 13th month was worked out (basic pay
  /// earned this year, divided by 12, less 13th month already paid). Null on
  /// other run types and on sheets computed before PAY-168.
  thirteenthMonthBreakdown Json?
  /// YEAR_END-only: year-end annualization true-up result.  Written by the
  /// POST /api/payroll/runs/[id]/annualize endpoint while the run is a DRAFT
  /// (PAY-155: a finalized run is never changed).
  annualizationData        Json?
  /// Array of { id, kind, amountCents, isTaxable, reason } applied in this run.
  adjustmentsApplied       Json?
  /// Array of { id, category, amountCents, taxTreatment, taxablePortionCents, nontaxablePortionCents }.
  expenseClaimsApplied     Json?

  /// R2 object key for the published payslip PDF.  Null until payslip.publish job completes.
  payslipKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  payrollBook PayrollBook @relation(fields: [payrollBookId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id])

  /// PAY-194: the held cutoffs this sheet releases (strict DTR policy), with
  /// each cutoff's figures, which are included in this sheet's amounts.
  heldRelease Json?

  /// PAY-152: this payslip's 13th-month base (REGULAR runs) and its accrual, one twelfth of it. Recorded at finalize, never paid.
  thirteenthAccrualBasisCents BigInt?
  thirteenthAccrualCents      BigInt?
  /// PAY-67: the payslip as it stood when the run was sealed; reprints come from this.
  sealSnapshot                Json?
  /// PAY-69: payslip control number, issued gapless at finalize (PS-YYYY-NNNNNN). Never changes once set.
  controlNumber               String?
  corrections                 PayrollCorrection[]

  @@unique([tenantId, controlNumber])
  @@unique([payrollBookId, employeeId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([payrollBookId])
}

/// One-off monetary addition or deduction applied to a specific DRAFT payroll
/// run.  Created by payroll operators before finalizing the book; consumed by
/// the engine in the gross-to-net waterfall.
model PayrollAdjustment {
  id            String @id @default(cuid())
  tenantId      String
  employeeId    String
  payrollBookId String

  /// Whether this is a positive addition or a negative deduction.
  kind        AdjustmentKind
  /// Always stored as a positive value; `kind` determines the sign direction.
  amountCents BigInt
  /// True → included in gross compensation (taxable); False → added back
  /// after WHT as a non-taxable reimbursement/allowance.
  isTaxable   Boolean        @default(true)
  /// Required audit trail (e.g. "Bonus adjustment", "Salary overpayment").
  reason      String         @db.Text

  /// PAY-68: set when the adjustment is a correction landing forward.
  correctionId String?
  correction   PayrollCorrection? @relation(fields: [correctionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])
  payrollBook PayrollBook @relation(fields: [payrollBookId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([payrollBookId])
  @@index([employeeId])
}

// =============================================================================
// EXPENSE CLAIMS (Phase K)
// =============================================================================

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ATTACHED
  PAID
}

enum ExpenseTaxTreatment {
  /// Reimbursement — not in gross compensation; added back after WHT.
  NONTAXABLE_REIMBURSEMENT
  /// Non-taxable benefit (within BIR de minimis ceiling).
  DE_MINIMIS
  /// Fully taxable — included in gross taxable income.
  TAXABLE
}

// =============================================================================
// SHIFT SCHEDULES & DTR (Phase J)
// =============================================================================

/// Named shift template — defines expected start/end and work days.
model ShiftSchedule {
  id       String @id @default(cuid())
  tenantId String

  name               String
  /// Optional short code for payslips/reports (e.g. "FIXED-8", "FLEX-MOR").
  code               String?
  type               ShiftType   @default(FIXED)
  /// Expected time-in in 24-hour "HH:MM" format. Null for FLEXIBLE shifts.
  timeIn             String?
  /// Expected time-out in 24-hour "HH:MM" format. Null for FLEXIBLE shifts.
  timeOut            String?
  /// Required hours per day for FLEXIBLE/OPEN shifts (e.g. 8.0). Ignored for FIXED.
  requiredHours      Float?
  /// Core window start for FLEXIBLE shifts — "HH:MM". Null for FIXED and OPEN.
  coreTimeIn         String?
  /// Core window end for FLEXIBLE shifts — "HH:MM". Null for FIXED and OPEN.
  coreTimeOut        String?
  /// Minutes after expected time-in before tardiness is recorded (0 = strict).
  gracePeriodMinutes Int         @default(0)
  breakMinutes       Int         @default(60)
  breakPolicy        BreakPolicy @default(FIXED_DEDUCTION)
  /// True when the shift spans midnight (e.g. night shift 22:00–06:00).
  crossesMidnight    Boolean     @default(false)
  /// JSON array of ISO weekday names: ["MON","TUE","WED","THU","FRI"].
  workDays           Json
  /// If set, the daily worked-minutes threshold above which OT is suggested
  /// (and, when otAutoApprove is on, auto-approved). Null = no suggestion.
  otThresholdMinutes Int?

  // -- Overtime policy (per-shift) ------------------------------------------
  /// OT is never paid from the threshold alone — it must be approved.
  otRequiresApproval  Boolean     @default(true)
  /// Employer safeguard: auto-create an APPROVED OT application for worked
  /// minutes beyond otThresholdMinutes (still subject to the break rule below).
  otAutoApprove       Boolean     @default(false)
  /// Break-deduction rule applied to approved OT hours.
  otBreakMode         OtBreakMode @default(NONE)
  /// SINGLE: deduct otBreakMinutes once OT ≥ this many hours.
  otBreakTriggerHours Decimal?    @db.Decimal(5, 2)
  /// TIERED: deduct otBreakMinutes for every this-many hours of OT.
  otBreakBlockHours   Decimal?    @db.Decimal(5, 2)
  /// Minutes deducted each time the OT break rule fires.
  otBreakMinutes      Int?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  assignments     EmployeeShiftAssignment[]
  dtrRecords      DTRRecord[]
  employees       Employee[]
  employmentTerms EmploymentTerm[]
  movements       EmployeeMovement[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Effective-dated assignment of a ShiftSchedule to an Employee.
model EmployeeShiftAssignment {
  id              String @id @default(cuid())
  tenantId        String
  employeeId      String
  shiftScheduleId String

  effectiveFrom DateTime
  /// Null = open-ended (current assignment).
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  employee      Employee      @relation(fields: [employeeId], references: [id])
  shiftSchedule ShiftSchedule @relation(fields: [shiftScheduleId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId, effectiveFrom])
}

/// One computed daily attendance record per employee per calendar date.
/// Created from AttendanceLog (kiosk/manual) or imported; computed against
/// the assigned ShiftSchedule.
model DTRRecord {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// Calendar date this record covers (stored as UTC midnight).
  date            DateTime
  shiftScheduleId String?

  dayStatus          DTRDayStatus @default(PRESENT)
  workedMinutes      Int          @default(0)
  lateMinutes        Int          @default(0)
  undertimeMinutes   Int          @default(0)
  /// Pre-approved overtime minutes for this day. Only ever set from an
  /// APPROVED OT application (manual or employer auto-approve) — never paid
  /// from the shift threshold alone.
  otMinutes          Int          @default(0)
  /// Advisory only: worked minutes flagged beyond the shift OT threshold.
  /// Surfaced to supervisors as a "file OT?" hint; NEVER consumed by payroll.
  suggestedOtMinutes Int          @default(0)
  /// Night-shift differential minutes (10 PM – 6 AM window).
  nsdMinutes         Int          @default(0)
  hazardMinutes      Int          @default(0)
  /// True when the day has a clock-in but no clock-out (forgotten OUT). Flags
  /// the record for HR instead of silently reading as a zero-hour present day.
  hasMissingPunch    Boolean      @default(false)
  /// Paid-leave minutes credited to this day (from an approved leave). Counts
  /// toward paid time and suppresses undertime for the covered portion.
  paidLeaveMinutes   Int          @default(0)
  /// The approved leave that wrote this day's leave status, if any.
  leaveTransactionId String?
  /// SPECIAL_HOLIDAY | REGULAR_HOLIDAY | null
  holidayType        String?

  approvalStatus DTRStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  /// Locked records cannot be edited — set by payroll finalize.
  isLocked       Boolean   @default(false)

  /// Wave G3 (PAY-217): an unpaid day written by an incident's suspension.
  incidentReportId String?

  notes String? @db.Text

  // -- Official layer (sourced from AttendanceLog, immutable after write) ----
  /// Captured clock-in timestamp from GPS/kiosk. Never updated after first write.
  officialTimeIn  DateTime?
  /// Captured clock-out timestamp from GPS/kiosk. Never updated after first write.
  officialTimeOut DateTime?

  // -- Manual override layer ------------------------------------------------
  /// Employee or Supervisor manual clock-in correction.
  manualTimeIn     DateTime?
  /// Employee or Supervisor manual clock-out correction.
  manualTimeOut    DateTime?
  manualReasonCode DTRManualReasonCode?
  manualNotes      String?              @db.Text
  /// "EMPLOYEE" | "SUPERVISOR" — role of the last actor to write the manual layer.
  manualActorRole  String?
  /// References the Employee who last wrote the manual layer.
  manualActorId    String?
  manualUpdatedAt  DateTime?

  // -- Effective layer (system-computed: Supervisor > Employee > Official) ---
  /// The time-in value consumed by the Payroll Engine.
  effectiveTimeIn  DateTime?
  /// The time-out value consumed by the Payroll Engine.
  effectiveTimeOut DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  shiftSchedule    ShiftSchedule?    @relation(fields: [shiftScheduleId], references: [id])
  leaveTransaction LeaveTransaction? @relation(fields: [leaveTransactionId], references: [id], onDelete: SetNull)
  auditLogs        DTRAuditLog[]

  @@unique([tenantId, employeeId, date])
  @@index([incidentReportId])
  @@index([tenantId])
  @@index([tenantId, employeeId, date])
  @@index([tenantId, approvalStatus])
}

// =============================================================================
// DTR SUBMISSION (Track A — period-level submission & approval chain)
// =============================================================================

/// One row per employee per payroll cutoff period.  Created when the employee
/// taps "Submit DTR" in the ESS.  Flows through Supervisor → Manager approval
/// before the Payroll Engine may consume the underlying DTRRecord rows.
model DTRSubmission {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// Inclusive start of the cutoff period (UTC midnight).
  periodStart DateTime
  /// Inclusive end of the cutoff period (UTC midnight).
  periodEnd   DateTime

  submittedAt DateTime            @default(now())
  status      DTRSubmissionStatus @default(SUBMITTED)

  /// Active step pointer into the ApprovalStep chain (module = DTR).
  currentStepIndex Int @default(0)

  /// Employee who acted as Supervisor reviewer (usually immediateSupervisor).
  supervisorId      String?
  supervisorActedAt DateTime?

  /// Employee who acted as Manager approver.
  managerId      String?
  managerActedAt DateTime?

  /// Populated when status = RETURNED. Free-text reason for the return.
  returnedReason String?   @db.Text
  returnedAt     DateTime?
  /// "SUPERVISOR" | "MANAGER" — which role issued the Return action.
  returnedByRole String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  employee   Employee      @relation("DTRSubmissionEmployee", fields: [employeeId], references: [id])
  supervisor Employee?     @relation("DTRSubmissionSupervisor", fields: [supervisorId], references: [id])
  manager    Employee?     @relation("DTRSubmissionManager", fields: [managerId], references: [id])
  auditLogs  DTRAuditLog[]

  @@unique([tenantId, employeeId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, periodStart, periodEnd])
}

// =============================================================================
// DTR AUDIT LOG (Track A — immutable manual-edit trail)
// =============================================================================

/// Immutable append-only record of every manual time override written to a
/// DTRRecord.  Visible to Managers and HR Admins; never deleted or updated.
model DTRAuditLog {
  id              String  @id @default(cuid())
  tenantId        String
  dtrRecordId     String
  /// FK to the period submission this edit belongs to.  Null if the edit
  /// was made by the employee before any submission existed.
  dtrSubmissionId String?

  /// "EMPLOYEE" | "SUPERVISOR"
  actorRole String
  /// Employee.id of the actor.
  actorId   String

  /// "manual_time_in" | "manual_time_out"
  fieldChanged String
  /// Previous value as ISO string; null when field was previously empty.
  oldValue     String?
  /// New value as ISO string.
  newValue     String?

  reasonCode DTRManualReasonCode
  notes      String?             @db.Text

  /// Immutable — use @default(now()); never expose an update endpoint.
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  dtrRecord     DTRRecord      @relation(fields: [dtrRecordId], references: [id])
  dtrSubmission DTRSubmission? @relation(fields: [dtrSubmissionId], references: [id])

  @@index([tenantId])
  @@index([dtrRecordId])
  @@index([dtrSubmissionId])
  @@index([actorId])
}

// =============================================================================
// ATTENDANCE LOG (Phase Y) — raw punch records from kiosk / ESS / import
// =============================================================================

/// One row per clock punch (IN or OUT).  Drives DTRRecord computation.
/// Geofence violations are flagged but never block the punch (Section 5.3).
model AttendanceLog {
  id         String  @id @default(cuid())
  tenantId   String
  employeeId String
  /// FK to Kiosk — null for ESS/import/manual punches.
  kioskId    String?

  punchType PunchType // IN | OUT
  source    PunchSource // KIOSK | ESS | IMPORT | MANUAL
  /// Server-side timestamp of the punch (stored UTC).
  punchedAt DateTime

  /// R2 object key for selfie image.  Null when selfie was not captured.
  selfieKey       String?
  /// Raw JPEG bytes stored directly in DB when R2 is not configured.
  selfieData      Bytes?
  /// GPS latitude at punch time.  Null when location was not captured.
  latitude        Decimal? @db.Decimal(10, 7)
  /// GPS longitude at punch time.  Null when location was not captured.
  longitude       Decimal? @db.Decimal(10, 7)
  /// True when the punch was captured outside the assigned branch geofence.
  outsideGeofence Boolean  @default(false)
  /// Haversine distance in metres from the nearest active geofence centre.
  distanceMeters  Int?
  /// Wave F1 (PAY-216): the fence a field worker's punch fell inside.
  siteName        String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  kiosk    Kiosk?   @relation(fields: [kioskId], references: [id])

  @@index([tenantId, employeeId, punchedAt])
  @@index([tenantId, punchedAt])
  @@index([kioskId])
}

// =============================================================================
// EXPENSE CLAIMS (Phase K)
// =============================================================================

/// Employee expense reimbursement / claim record.
/// Flow: DRAFT → SUBMITTED → APPROVED (taxTreatment set) → ATTACHED (to a
/// PayrollBook) → PAID (after finalize).
model ExpenseClaim {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// The category's code (reports read this). Wave A2: from the company's list.
  category    String
  /// Wave A2 (PAY-209): the company's Expense Categories and Expense Types items.
  categoryId  String?
  typeId      String?
  /// Wave A2 (decision 6): limits the claim goes over, recorded at submission
  /// and again at approval. Flagged for the approver, never blocking.
  limitFlags  Json     @default("[]")
  description String   @db.Text
  /// Claim amount in centavos.
  amountCents BigInt
  /// Object store key for the attached receipt (e.g. R2 key). Nullable.
  receiptKey  String?
  /// The date the expense was incurred (UTC midnight).
  claimDate   DateTime

  status             ExpenseClaimStatus   @default(DRAFT)
  /// Set by Finance/HR during APPROVAL. Drives engine treatment.
  taxTreatment       ExpenseTaxTreatment?
  /// Wave A2: why the approver chose a treatment other than the type's.
  taxTreatmentReason String?              @db.Text

  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?   @db.Text

  /// Set to the target PayrollBook when status = ATTACHED.
  payrollBookId String?
  /// Set to the PayrollBook that finalized (paid) this claim.
  paidInBookId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  approvedBy   User?        @relation("ExpenseClaimApprover", fields: [approvedById], references: [id])
  payrollBook  PayrollBook? @relation("BookExpenseClaims", fields: [payrollBookId], references: [id])
  paidInBook   PayrollBook? @relation("BookPaidExpenseClaims", fields: [paidInBookId], references: [id])
  categoryItem LookupItem?  @relation("ExpenseClaimCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  typeItem     LookupItem?  @relation("ExpenseClaimType", fields: [typeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([payrollBookId])
  @@index([tenantId, employeeId, categoryId, claimDate])
}

// =============================================================================
// OT APPLICATIONS (Phase R)
// =============================================================================

/// Employee files overtime for advance approval before it is paid.
/// On APPROVED the linked DTRRecord.otMinutes is set = hours × 60.
model OTApplication {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// Calendar date the OT will be worked (UTC midnight).
  date          DateTime
  /// Requested OT hours (e.g. 2.5).
  hours         Decimal  @db.Decimal(5, 2)
  justification String   @db.Text

  status          ApprovalStatus @default(PENDING)
  approverId      String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?        @db.Text
  cancelledAt     DateTime?

  /// Active step pointer into the ApprovalStep chain (module = OT).
  currentStepIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

// =============================================================================
// UNDERTIME REQUESTS (Phase V)
// =============================================================================

/// Employee files an early-departure notification for supervisor approval.
/// On APPROVED the day's undertime is EXCUSED — the aggregator subtracts these
/// minutes from the deductible total, so an approved early-out is not deducted.
model UndertimeRequest {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// Calendar date of early departure (UTC midnight).
  date             DateTime
  /// Number of minutes departed early.
  undertimeMinutes Int
  reason           String   @db.Text

  status          ApprovalStatus @default(PENDING)
  approverId      String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?        @db.Text
  cancelledAt     DateTime?

  /// Active step pointer into the ApprovalStep chain (module = UNDERTIME).
  currentStepIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

// =============================================================================
// PROFILE UPDATE REQUESTS (Phase R)
// =============================================================================

/// Employee requests a change to a sensitive profile field.
/// On APPROVED the field on Employee is updated atomically.
model ProfileUpdateRequest {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// Name of the Employee field being changed (e.g. "bankAccountNumber").
  field    String
  oldValue String? @db.Text
  newValue String  @db.Text

  status          ApprovalStatus @default(PENDING)
  approverId      String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

// =============================================================================
// ESS SESSIONS (Phase M)
//
// Short-lived tokens for Employee Self-Service portal.  The raw 32-byte
// random token is returned to the client; only the SHA-256 hex digest is
// persisted.  Sessions last 8 hours and can be revoked explicitly (logout).
// =============================================================================

// =============================================================================
// ATS — Applicant Tracking System (Phase W)
//
// Pipeline: JobPosting → Applicant (staged) → 1-click hire → Employee.
// Résumés stored in R2; notes tracked per applicant.
// All tables RLS-protected (tenant_isolation).
// =============================================================================

enum JobPostingStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicantSource {
  REFERRAL
  ONLINE_POSTING
  WALK_IN
  AGENCY
  OTHER
}

/// A job vacancy posted by the tenant HR team.
model JobPosting {
  id       String @id @default(cuid())
  tenantId String

  title        String
  /// Optional short code, unique per tenant (e.g. "DEV-SENIOR-2026").
  code         String?
  description  String? @db.Text
  departmentId String?
  branchId     String?
  positionId   String?
  headcount    Int     @default(1)

  status   JobPostingStatus @default(DRAFT)
  openedAt DateTime?
  closedAt DateTime?

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])
  createdBy  User?       @relation(fields: [createdById], references: [id])

  applicants Applicant[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
}

/// An individual who applied for a job posting.
model Applicant {
  id           String @id @default(cuid())
  tenantId     String
  jobPostingId String

  firstName String
  lastName  String
  email     String?
  phone     String?

  /// R2 object key for the uploaded résumé file.
  resumeKey String?

  stage  ApplicantStage  @default(APPLIED)
  source ApplicantSource @default(ONLINE_POSTING)
  /// Reviewer rating 1–5; null = not yet rated.
  rating Int?

  assignedToUserId String?
  /// Set when stage=HIRED via 1-click hire conversion.
  hiredEmployeeId  String? @unique

  rejectionReason String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id])
  assignedTo    User?      @relation("ApplicantAssignedTo", fields: [assignedToUserId], references: [id])
  hiredEmployee Employee?  @relation(fields: [hiredEmployeeId], references: [id])

  notes ApplicantNote[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([jobPostingId])
}

/// HR notes on an applicant (immutable audit trail; only soft-deleted).
model ApplicantNote {
  id          String @id @default(cuid())
  tenantId    String
  applicantId String

  body     String  @db.Text
  authorId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  applicant Applicant @relation(fields: [applicantId], references: [id])
  author    User?     @relation(fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([applicantId])
}

// =============================================================================
// ESS SESSIONS (Phase M)
//
// Short-lived tokens for Employee Self-Service portal.  The raw 32-byte
// random token is returned to the client; only the SHA-256 hex digest is
// persisted.  Sessions last 8 hours and can be revoked explicitly (logout).
// =============================================================================

/// Employee Self-Service session.  One row per active login.
/// Employee Self-Service portal access lifecycle.
///   NOT_INVITED — created but no ESS access (default); login blocked.
///   INVITED     — granted access, not yet logged in for the first time.
///   ACTIVE      — has logged in at least once.
///   DISABLED    — access revoked (manually or by a scheduled deactivation).
enum EssAccessStatus {
  NOT_INVITED
  INVITED
  ACTIVE
  DISABLED
}

/// Which of the employee's emails receives ESS invitation and reset links.
enum EssEmailChoice {
  PERSONAL
  WORK
}

/// One-time email invitation to activate ESS access (set a password). The raw
/// token is emailed; only its SHA-256 hash is stored. Expires; single-use.
model EssInvite {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

/// One-time ESS password-reset token (forgot-password flow). Raw token emailed;
/// only its SHA-256 hash stored. Expires; single-use.
model EssPasswordReset {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

model EssSession {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// SHA-256 hex digest of the raw 32-byte token (never stored in clear text).
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([expiresAt])
}

/// WebAuthn / passkey credential registered by an ESS employee for biometric login.
/// One employee can have multiple credentials (phone + laptop etc.).
model EssWebAuthnCredential {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  /// Base64url-encoded credential ID returned by the authenticator.
  credentialId String @unique

  /// CBOR-encoded public key (base64url), used for assertion verification.
  publicKey String @db.Text

  /// Incremented on every successful assertion; protects against replay attacks.
  counter BigInt @default(0)

  /// Authenticator AAGUID (UUID string) — identifies device model.
  aaguid String?

  /// Human-readable label set by the user (e.g. "iPhone 15 Face ID").
  label String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId])
}

// =============================================================================
// HOLIDAY CALENDAR (Phase AD)
//
// Tenant-managed public / company holiday registry.  The payroll engine reads
// this table when resolving holiday multipliers for a given date and employee.
//
// Lookup contract:
//   1. Find rows where `date` falls within the payroll period.
//   2. Check `scope`:
//      • COMPANY_WIDE → applies to all employees.
//      • BRANCH_SPECIFIC → applies only when employee.branchId is in `branchIds`.
//   3. For AREA_SPECIFIC category → additionally restrict to employees whose
//      branch.workLocation.region matches `region`.
//   4. Multiple holidays on the same date → use the highest multiplier
//      (LEGAL > SPECIAL_NON_WORKING / SPECIAL_ONE_TIME / AREA_SPECIFIC).
// =============================================================================

model Holiday {
  id       String @id @default(cuid())
  tenantId String

  name     String
  category HolidayCategory
  /// Calendar date of the holiday (stored as UTC midnight, e.g. 2026-06-12T00:00:00Z).
  date     DateTime

  /// When true, the holiday recurs every year on the same month+day.
  recurringAnnually Boolean @default(false)

  /// For recurring holidays: JSON array of "YYYY-MM-DD" strings whose specific
  /// yearly occurrence has been cancelled ("delete this year only"). The master
  /// row keeps recurring for every other year.
  skippedDates Json @default("[]")

  scope     HolidayScope @default(COMPANY_WIDE)
  /// Non-empty only when scope = BRANCH_SPECIFIC. Array of Branch IDs.
  branchIds Json         @default("[]")

  /// Non-empty only when category = AREA_SPECIFIC. PH region code (e.g. "NCR").
  region       String?
  /// Optional city/province qualifier for AREA_SPECIFIC holidays.
  provinceCity String?

  /// Presidential / IATF proclamation number for traceability.
  proclamationReference String?
  notes                 String? @db.Text

  /// True when the exact date is not yet fixed by proclamation (e.g. Eid dates).
  isTentative Boolean @default(false)

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, category])
  @@index([deletedAt])
}

// =============================================================================
// PREMIUM RATE CONFIG (Phase AE1)
//
// Tenant-overridable premium multipliers. Rows exist only for rates that
// differ from DOLE minimums. The engine falls back to DOLE defaults for any
// key not present in this table.
// =============================================================================

model PremiumRateConfig {
  id            String               @id @default(cuid())
  tenantId      String
  multiplierKey PremiumMultiplierKey
  /// Multiplier value (e.g. 1.30 for REST_DAY). Must be >= DOLE floor.
  rate          Decimal              @db.Decimal(8, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, multiplierKey])
  @@index([tenantId])
}

// ============================================================
// BILLING
// Central Portal billing: packages, per-tenant subscriptions,
// invoices, and payments. Manual record-keeping for now;
// nullable gateway* fields make payment-gateway integration
// a drop-in later (no schema rewrite needed).
// Money is stored as BigInt centavos (PHP); never use floats.
// Tax rate is stored as Int basis points (1200 = 12.00%).
// ============================================================

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  MANUAL
  BANK_TRANSFER
  CASH
  CHECK
  // Gateway-backed methods added later: CARD, GCASH, MAYA, etc.
}

/// Catalog of billing packages (plans). Free-form: any number of packages,
/// each optionally tagged with a coarse tier for badge colour / grouping.
/// monthlyPrice / annualPrice are centavos. taxRateBps is basis points.
model BillingPackage {
  id           String            @id @default(cuid())
  /// Optional coarse tag (badge colour / analytics grouping). No longer unique.
  tier         SubscriptionTier?
  name         String
  description  String?
  monthlyPrice BigInt            @default(0)
  annualPrice  BigInt            @default(0)
  /// Tax rate in basis points applied to invoices for this package (1200 = 12%).
  taxRateBps   Int               @default(0)
  currency     String            @default("PHP")
  isActive     Boolean           @default(true)
  /// Only published packages can be assigned to tenants / offered.
  isPublished  Boolean           @default(true)
  /// Display order in the Packages list (ascending).
  sortOrder    Int               @default(0)
  /// Marketing/feature list shown alongside the package.
  features     Json              @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@index([isPublished])
}

/// The live billing state for a tenant. At most one per tenant.
model TenantSubscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  packageId          String
  billingCycle       BillingCycle       @default(MONTHLY)
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  /// Gateway subscription id (e.g. Stripe sub_...) once integrated.
  externalId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package  BillingPackage @relation(fields: [packageId], references: [id])
  invoices Invoice[]

  @@index([packageId])
  @@index([status])
}

/// An issued bill for a tenant. Amounts are centavos, snapshotted at issue
/// time so later package price/tax changes never rewrite invoice history.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNumber  String        @unique
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       BigInt        @default(0)
  taxAmount      BigInt        @default(0)
  total          BigInt        @default(0)
  currency       String        @default("PHP")
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  /// Gateway invoice id once integrated.
  externalId     String?
  /// Snapshot of line items: [{ description, quantity, unitPrice, amount }] (centavos)
  lineItems      Json          @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@index([tenantId])
  @@index([status])
  @@index([subscriptionId])
}

/// A payment recorded against an invoice. amount is centavos. Manual entry
/// now; gateway* fields stay null until a webhook fills them in.
model Payment {
  id               String        @id @default(cuid())
  tenantId         String
  invoiceId        String
  amount           BigInt        @default(0)
  currency         String        @default("PHP")
  method           PaymentMethod @default(MANUAL)
  reference        String?
  paidAt           DateTime      @default(now())
  recordedById     String?
  notes            String?
  /// Gateway fields, populated only when a payment gateway is integrated.
  gatewayProvider  String?
  gatewayReference String?
  gatewayPayload   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
}

// ============================================================
// CENTRAL PORTAL — support tickets, subscription history,
// and the platform-level audit feed (PR 2).
// ============================================================

enum TicketPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

/// A support ticket raised against a tenant account, worked by central agents.
model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  tenantId     String
  subject      String
  body         String?
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  agentUserId  String? // null = Unassigned

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  User?  @relation("TicketAgent", fields: [agentUserId], references: [id])

  @@index([status])
  @@index([tenantId])
  @@index([agentUserId])
}

enum SubscriptionEventType {
  TRIAL_STARTED
  SUBSCRIBED
  UPGRADED
  DOWNGRADED
  RENEWED
  PAYMENT_FAILED
  CANCELLED
  REACTIVATED
}

/// Append-only timeline of a tenant's subscription lifecycle. Powers the
/// Tenant-detail "Subscription history" tab and the retention analytics.
model SubscriptionEvent {
  id          String                @id @default(cuid())
  tenantId    String
  type        SubscriptionEventType
  detail      String?
  actorUserId String? // central admin who triggered the change, if any

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([type])
}

enum CentralAuditKind {
  SECURITY
  BILLING
  TENANT
  SYSTEM
}

/// Platform-level audit feed for the Central Portal — privileged super-admin
/// actions, including ones not tied to a single tenant (role / admin changes).
/// Distinct from the tenant-scoped AuditLog.
model CentralAuditEvent {
  id          String           @id @default(cuid())
  actorUserId String?
  /// Snapshot of the actor's display name (survives later user deletion).
  actorName   String
  action      String
  target      String
  kind        CentralAuditKind @default(SYSTEM)
  tenantId    String? // optional link to a tenant (drives the Activity tab)
  ipAddress   String?
  metadata    Json?

  createdAt DateTime @default(now())

  actor  User?   @relation("CentralAuditActor", fields: [actorUserId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([createdAt])
  @@index([kind])
  @@index([tenantId, createdAt])
}

/// PAY-69 (Q3b, Mark 17 Nov): the gapless counters behind document control
/// numbers, one per company, document type and year. A number is claimed in
/// the same transaction that finalizes the document, so a rolled-back
/// finalize gives its number back and the series never has a gap.
model DocumentSeries {
  id         String   @id @default(cuid())
  tenantId   String
  /// PAYROLL_RUN or PAYSLIP.
  docType    String
  seriesYear Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, docType, seriesYear])
  @@index([tenantId])
}

/// PAY-68 (1.13, Q1b, Mark 17 Nov 2026): a correction is a new document, never
/// an edit. It points at a finalized payslip, carries signed lines (effect on
/// pay), is approved by a second person, gets a control number (PC-YYYY-NNNN)
/// and lands forward as adjustments in a later draft run. A correction can be
/// corrected by another one; the cumulative guard keeps all of them together
/// from reversing more than the payslip paid.
enum PayrollCorrectionStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model PayrollCorrection {
  id              String                  @id @default(cuid())
  tenantId        String
  employeeId      String
  originalSheetId String
  /// The correction this one corrects, if any.
  correctsId      String?
  /// PAY-166: CORRECTION, or RETRO_PAY for a retroactive salary increase.
  kind            String                  @default("CORRECTION")
  /// PAY-166: the retroactive increase this belongs to (one per payslip of the period).
  batchId         String?
  /// Issued at approval, gapless (DocumentSeries PAYROLL_CORRECTION).
  controlNumber   String?
  status          PayrollCorrectionStatus @default(DRAFT)
  reason          String                  @db.Text
  /// [{ item, amountCents (signed, effect on pay), taxable, description }]
  lines           Json
  netEffectCents  BigInt
  /// The draft run it landed in; cleared if that draft is discarded.
  targetBookId    String?

  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  originalSheet PayrollSheet        @relation(fields: [originalSheetId], references: [id], onDelete: Cascade)
  corrects      PayrollCorrection?  @relation("CorrectionOfCorrection", fields: [correctsId], references: [id], onDelete: SetNull)
  correctedBy   PayrollCorrection[] @relation("CorrectionOfCorrection")
  targetBook    PayrollBook?        @relation("CorrectionTarget", fields: [targetBookId], references: [id], onDelete: SetNull)
  adjustments   PayrollAdjustment[]

  @@unique([tenantId, controlNumber])
  @@index([tenantId])
  @@index([originalSheetId])
  @@index([targetBookId])
  @@index([tenantId, batchId])
}

/// PAY-197 (Mark, 20 Nov 2026): the Offboarding module. Ruling 2: clearance
/// signatories come from a company checklist HR sets up (items with assigned
/// signatories), copied into each case and routed. Ruling 3: the final pay run
/// cannot be finalized until clearance is complete.
model ClearanceTemplateItem {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  /// The user who signs this item off.
  signatoryUserId String
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signatory User   @relation("ClearanceTemplateSignatory", fields: [signatoryUserId], references: [id])

  @@index([tenantId])
}

enum OffboardingCaseStatus {
  OPEN
  CLEARED
  CLOSED
}

/// PAY-197: one offboarding case per separation, with each step, owner and status.
model OffboardingCase {
  id                  String                @id @default(cuid())
  tenantId            String
  employeeId          String
  separationReason    SeparationReason
  lastWorkingDay      DateTime
  status              OffboardingCaseStatus @default(OPEN)
  notes               String?
  createdByUserId     String?
  clearedAt           DateTime?
  closedAt            DateTime?
  /// PAY-197 part 2: what the leaving employee filed in the offboarding portal.
  exitQuestionnaire   Json?
  exitQuestionnaireAt DateTime?
  /// Forwarding address, personal email and phone, bank for the final pay (account number encrypted).
  personalInfo        Json?
  personalInfoAt      DateTime?
  coeRequestedAt      DateTime?
  /// PAY-197 part 3: when HR issued the certificate of employment (the portal then offers it).
  coeIssuedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items          ClearanceItem[]
  portalLinks    OffboardingPortalLink[]
  portalSessions OffboardingPortalSession[]

  @@index([tenantId, status])
  @@index([employeeId])
}

enum ClearanceItemStatus {
  PENDING
  CLEARED
}

model ClearanceItem {
  id              String              @id @default(cuid())
  tenantId        String
  caseId          String
  name            String
  description     String?
  signatoryUserId String
  sortOrder       Int                 @default(0)
  status          ClearanceItemStatus @default(PENDING)
  remarks         String?
  clearedAt       DateTime?
  clearedByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case      OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  signatory User            @relation("ClearanceItemSignatory", fields: [signatoryUserId], references: [id])

  @@index([tenantId])
  @@index([caseId])
  @@index([signatoryUserId, status])
}

/// PAY-197 part 2 (ruling 4): the sign-in link to the offboarding portal,
/// sent to the leaving employee's personal email. Only its hash is kept.
model OffboardingPortalLink {
  id        String    @id @default(cuid())
  tenantId  String
  caseId    String
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  retiredAt DateTime?
  createdAt DateTime  @default(now())

  case OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

/// A signed-in offboarding portal visit. Never longer than the portal is open.
model OffboardingPortalSession {
  id        String    @id @default(cuid())
  tenantId  String
  caseId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  case OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

/// Wave A (the Soon plan, Mark approved 21 Nov 2026): the lists each company
/// keeps (banks, courses, trainers, document categories, expense categories
/// and types, incident categories, types and decisions, ethnicities,
/// religions), one table keyed by list. Each list's extra fields live in
/// `attributes`, checked by src/lib/lookups/registry.ts.
model LookupItem {
  id         String    @id @default(cuid())
  tenantId   String
  list       String
  code       String
  name       String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  /// Kept by Sentire: cannot be deleted or have its code changed.
  isSystem   Boolean   @default(false)
  attributes Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeesWithBank       Employee[]         @relation("EmployeeBank")
  expenseClaimsByCategory ExpenseClaim[]     @relation("ExpenseClaimCategory")
  expenseClaimsByType     ExpenseClaim[]     @relation("ExpenseClaimType")
  incidentsByType         IncidentReport[]   @relation("IncidentTypeItem")
  incidentsByCategory     IncidentReport[]   @relation("IncidentCategoryItem")
  incidentsByDecision     IncidentReport[]   @relation("IncidentDecisionItem")
  documentsByCategory     EmployeeDocument[] @relation("DocumentCategoryItem")
  trainingsByCourse       EmployeeTraining[] @relation("TrainingCourseItem")
  trainingsByTrainer      EmployeeTraining[] @relation("TrainingTrainerItem")

  @@unique([tenantId, list, code])
  @@index([tenantId, list])
}

// =============================================================================
// DOCUMENT WORKFLOW (Wave C3, PAY-213)
// =============================================================================

/// A letter HR issues on request (Certificate of Employment, COE with
/// compensation, clearance). Title and body hold {{merge}} fields
/// (src/lib/documents/templates.ts).
model DocumentTemplate {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  title          String
  body           String    @db.Text
  signatoryName  String?
  signatoryTitle String?
  /// Uses a salary field: only a role that may see pay approves it.
  showsSalary    Boolean   @default(false)
  /// Employees may request it in ESS.
  availableInEss Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests DocumentRequest[]

  @@index([tenantId])
}

/// An employee's request for a document. The letter's text is filled and
/// kept at approval, so it never changes afterwards.
model DocumentRequest {
  id               String         @id @default(cuid())
  tenantId         String
  employeeId       String
  templateId       String
  purpose          String?
  status           ApprovalStatus @default(PENDING)
  currentStepIndex Int            @default(0)
  decidedByUserId  String?
  decidedAt        DateTime?
  rejectionReason  String?        @db.Text
  renderedTitle    String?
  renderedBody     String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id])
  template DocumentTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId, status])
  @@index([employeeId])
}

// =============================================================================
// LEAVE EARNING POLICIES (Wave E1, PAY-215)
// =============================================================================

/// A reusable accrual rule for one leave type, assigned to a group of
/// employees; applying it writes their LeaveEntitlement rows
/// (src/lib/leave/earning-policy.ts).
model LeaveEarningPolicy {
  id                  String           @id @default(cuid())
  tenantId            String
  name                String
  leaveTypeId         String
  accrualFrequency    AccrualFrequency
  accrualAmount       Decimal          @db.Decimal(6, 4)
  /// [{ fromYear, accrualAmount }]: the amount from that service anniversary on.
  tiers               Json             @default("[]")
  proRate             Boolean          @default(true)
  /// HIRE or REGULARIZATION: when the employee starts earning.
  earnFrom            String           @default("HIRE")
  /// Year end (Wave E2): days carried into the next year at most.
  carryOverCap        Decimal?         @db.Decimal(6, 4)
  /// Year end (Wave E2): months after the year end that carried days expire.
  expiresAfterMonths  Int?
  /// Year end (Wave E2): unused days, after carry-over, paid in cash.
  convertUnusedToCash Boolean          @default(false)
  /// Wave E2, decision 8: vacation leave, so up to 10 converted days a year are de minimis.
  vacationLeave       Boolean          @default(false)
  /// { employmentStatuses, levelIds, departmentIds, jobTypeIds }; an empty list means any.
  assignment          Json             @default("{}")
  effectiveFrom       DateTime
  isActive            Boolean          @default(true)
  lastAppliedAt       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id])
  entitlements LeaveEntitlement[]

  @@index([tenantId])
}

/// Wave E3 (PAY-215, decision 9): company shutdowns (leave filed for a group)
/// and blackout dates (src/lib/leave/schedule.ts).
model LeaveSchedule {
  id            String    @id @default(cuid())
  tenantId      String
  /// SHUTDOWN or BLACKOUT
  kind          String
  name          String
  startDate     DateTime
  endDate       DateTime
  /// Departments it covers; empty: everyone.
  departmentIds Json      @default("[]")
  /// SHUTDOWN: the leave type charged (an unpaid type for unpaid days).
  leaveTypeId   String?
  /// BLACKOUT: BLOCK refuses requests; FLAG lets them through for the approver to see.
  blackoutMode  String?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
}

// =============================================================================
// TEAM: DISCUSSION, DOCUMENT AND FORM SHARING (Wave F2, F3, PAY-216)
// =============================================================================

/// A discussion for an audience (departments, branches; empty: everyone).
/// HR can hide a post; the hide is audited (src/lib/team/discussion.ts).
model DiscussionThread {
  id               String    @id @default(cuid())
  tenantId         String
  title            String
  body             String    @db.Text
  audience         Json      @default("{}")
  authorEmployeeId String?
  authorUserId     String?
  authorName       String
  mentions         Json      @default("[]")
  hiddenAt         DateTime?
  hiddenByUserId   String?
  hiddenReason     String?
  lastActivityAt   DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments DiscussionComment[]

  @@index([tenantId, lastActivityAt])
}

model DiscussionComment {
  id               String    @id @default(cuid())
  tenantId         String
  threadId         String
  body             String    @db.Text
  authorEmployeeId String?
  authorUserId     String?
  authorName       String
  mentions         Json      @default("[]")
  hiddenAt         DateTime?
  hiddenByUserId   String?
  hiddenReason     String?
  createdAt        DateTime  @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// A file HR shares with an audience (handbook, policies, forms), versioned;
/// each version may need an "I have read and understood" acknowledgement.
model SharedDocument {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  description     String?
  audience        Json      @default("{}")
  requiresAck     Boolean   @default(false)
  currentVersion  Int       @default(1)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions SharedDocumentVersion[]
  acks     SharedDocumentAck[]

  @@index([tenantId])
}

model SharedDocumentVersion {
  id               String   @id @default(cuid())
  tenantId         String
  documentId       String
  version          Int
  fileName         String
  mimeType         String
  fileSize         Int
  /// Object storage key; null when the file is kept in the database (no storage configured).
  storageKey       String?
  data             Bytes?
  note             String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  document SharedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model SharedDocumentAck {
  id             String   @id @default(cuid())
  tenantId       String
  documentId     String
  version        Int
  employeeId     String
  acknowledgedAt DateTime @default(now())

  document SharedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version, employeeId])
}

// =============================================================================
// SALARY ADJUSTMENT (Wave G1, PAY-217): a bulk change of basic salary
// (percent, fixed amount, or bring to the regional minimum wage), approved by
// a second person; each line becomes one SALARY_ADJUSTMENT movement.
// =============================================================================

enum SalaryAdjustmentRule {
  PERCENT
  FIXED
  MIN_WAGE
}

model SalaryAdjustmentBatch {
  id                 String               @id @default(cuid())
  tenantId           String
  name               String
  rule               SalaryAdjustmentRule
  /// PERCENT: hundredths of a percent (525 = 5.25%).
  percentBasisPoints Int?
  /// FIXED: centavos added in the salary's own unit (per month or per day).
  fixedCents         BigInt?
  effectiveDate      DateTime
  reason             String
  status             ApprovalStatus       @default(PENDING)
  createdByUserId    String?
  approvedByUserId   String?
  approvedAt         DateTime?
  rejectionReason    String?
  /// PAY-166 retroactive batch made at approval for finalized payslips on or after the effective date.
  retroBatchId       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  SalaryAdjustmentLine[]

  @@index([tenantId, createdAt])
}

model SalaryAdjustmentLine {
  id                String     @id @default(cuid())
  tenantId          String
  batchId           String
  employeeId        String
  salaryType        SalaryType
  fromCents         BigInt
  toCents           BigInt
  movementId        String?
  /// The adjustment that takes back the days before the effective date in the run that straddles it.
  splitAdjustmentId String?

  batch    SalaryAdjustmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([batchId, employeeId])
  @@index([employeeId])
}

/// PAY-217 Causeless (Mark, 21 Nov 2026 22:25): a note on an employee with an
/// optional attachment; no cause, no decision, no sanction, nothing for payroll.
model CauselessNote {
  id              String    @id @default(cuid())
  tenantId        String
  employeeId      String
  noteDate        DateTime
  note            String
  fileName        String?
  mimeType        String?
  fileSize        Int?
  /// Object storage key when storage is configured, else the bytes in `data` (at most 10 MB).
  storageKey      String?
  data            Bytes?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, noteDate])
  @@index([employeeId])
}

/// Final pay withholding (Mark, 21 Nov 2026 22:25). REFUND_AND_WITHHOLD_FINAL:
/// the year's earlier withholding is returned and the final pay is taxed by
/// itself on the MONTHLY table. ANNUALIZE: RR 2-98 annualization at separation.
enum FinalPayTaxMethod {
  REFUND_AND_WITHHOLD_FINAL
  ANNUALIZE
}
