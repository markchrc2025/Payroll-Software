  MINIMUM_WAGE_RATE
}

// ---------------------------------------------------------------------------
// PAYROLL DOMAIN (Phase D2)
// ---------------------------------------------------------------------------

/// Broad family of a pay component. Drives default sign (earning vs deduction)
/// and the default taxability override matrix in the engine.
enum PayComponentKind {
  ALLOWANCE
  BONUS
  COMMISSION
  OTHER_EARNING
  REIMBURSEMENT
  DEDUCTION
}

/// Tax treatment of a pay component.
///   • TAXABLE — added to taxable gross.
///   • NON_TAXABLE — added to gross but not to BIR taxable base.
///   • DE_MINIMIS — subject to the RR 29-2025 ceiling (excess is taxable);
///                  `deMinimisCode` MUST be set and must reference a code from
///                  the active `DE_MINIMIS_CEILING` payload.
///   • STATUTORY_EXEMPT — mandatory contributions / 13th-month residual; engine
///                        emits these, not the catalog.
enum PayComponentTaxability {
  TAXABLE
  NON_TAXABLE
  DE_MINIMIS
  STATUTORY_EXEMPT
}

/// Loan source. Drives default ledger account and government-loan amortization
/// rules.
enum LoanType {
  SSS
  PAGIBIG
  CASH_ADVANCE
  COMPANY
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
  ON_HOLD
}

/// Payroll run lifecycle. DRAFT → FINALIZED is a one-way transition (writes
/// AuditLog + decrements loan balances). CANCELLED is reserved for runs that
/// were created in error before finalize.
enum PayrollBookStatus {
  DRAFT
  PROCESSING
  FINALIZED
  CANCELLED
}

/// PAY-144: where a year-to-date opening comes from.
///   PRIOR_PAYROLL     this company's own pay to the employee earlier in the
///                     year, before it used Sentire. It is this employer's
///                     compensation: 13th month base, 2316 and alphalist.
///   PREVIOUS_EMPLOYER another employer's 2316 for the same year (a new hire
///                     who transferred). Used for annualization and the
///                     90,000 exemption only.
enum YtdOpeningSource {
  PRIOR_PAYROLL
  PREVIOUS_EMPLOYER
}

enum PayrollRunType {
  REGULAR
  OFF_CYCLE
  FINAL_PAY
  YEAR_END
}

enum AdjustmentKind {
  ADDITION
  DEDUCTION
}

/// Reason an employee's employment was terminated.  Drives DOLE separation-pay
/// formula and BIR taxability rules for the FINAL_PAY run.
enum SeparationReason {
  /// Voluntary resignation — no statutory separation pay; any gratuity is taxable.
  RESIGNATION
  /// Mutually agreed separation — no statutory separation pay.
  MUTUAL_AGREEMENT
  /// End of project / fixed-term contract — no statutory separation pay.
  END_OF_CONTRACT
  /// Art. 298 RA 10361 — 1 month per year (or fraction ≥ 6 mo) of service.
  REDUNDANCY
  /// Art. 298 — 0.5 month per year (min 1 month); exempt from WHT.
  RETRENCHMENT
  /// Art. 298 — 1 month per year when not due to serious losses; exempt from WHT.
  CLOSURE_OF_BUSINESS
  /// Art. 299 — disease not curable within 6 months; 1 month per year; exempt.
  DISEASE
  /// Art. 297 — dismissal for just cause; no separation pay by law.
  JUST_CAUSE
}

// =============================================================================
// DTR / TIMESHEET ENUMS (Phase J)
// =============================================================================

enum ShiftType {
  FIXED
  FLEXIBLE
  OPEN
}

/// How a per-shift OT break-deduction rule fires.
enum OtBreakMode {
  /// No automatic break deduction from overtime.
  NONE
  /// Deduct a fixed break once total OT reaches a trigger (e.g. ≥ 6h → −1h).
  SINGLE
  /// Deduct a break for every N-hour block of OT (e.g. −1h per 4h).
  TIERED
}

enum BreakPolicy {
  /// System auto-deducts breakMinutes from the total span (firstIN → lastOUT).
  /// Employee does NOT clock out for lunch.
  FIXED_DEDUCTION
  /// Floating break: employee can take the break at any time; system deducts the fixed amount.
  FLOATING
  /// System sums only actual paired IN-OUT intervals.
  /// Employee must clock out before lunch and clock back in after.
  TRACK_ACTUAL
  /// Employee punches in/out for break explicitly.
  PUNCH_IN_OUT
  /// Break is paid — no deduction applied.
  PAID_BREAK
}

enum DTRStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Reason an employee or supervisor provides when writing a manual time override.
enum DTRManualReasonCode {
  FORGOT_CLOCK_IN
  FORGOT_CLOCK_OUT
  GPS_FAILURE
  KIOSK_OFFLINE
  SYSTEM_ERROR
  SCHEDULE_CHANGE
  /// Requires a non-empty `manualNotes` value at the application layer.
  OTHER
}

/// Multi-step lifecycle of a period-level DTR submission.
enum DTRSubmissionStatus {
  /// Employee has submitted; awaiting supervisor review.
  SUBMITTED
  /// Supervisor has reviewed and approved; awaiting manager sign-off.
  SUPERVISOR_APPROVED
  /// Manager has given final approval; eligible for payroll engine.
  MANAGER_APPROVED
  /// Returned by supervisor (back to employee) or manager (back to supervisor).
  RETURNED
}

enum DTRDayStatus {
  PRESENT
  ABSENT
  PAID_LEAVE
  UNPAID_LEAVE
  HOLIDAY
  REST_DAY
}

// =============================================================================
// ATTENDANCE ENUMS (Phase Y)
// =============================================================================

enum PunchType {
  IN
  OUT
}

enum PunchSource {
  KIOSK
  ESS
  IMPORT
  MANUAL
}

// =============================================================================
// HOLIDAY CALENDAR ENUMS (Phase AD)
// =============================================================================

/// DOLE holiday category — drives the payroll multiplier applied to the day.
enum HolidayCategory {
  /// Regular Holiday (Art. 94 Labor Code) — 200% pay if worked, 100% if not worked.
  LEGAL
  /// Special Non-Working Day (nationwide proclamation) — 130% if worked, no pay if not.
  SPECIAL_NON_WORKING
  /// Special One-Time Holiday (presidential proclamation) — 130% if worked.
  SPECIAL_ONE_TIME
  /// City/province/region-scoped holiday — 130% if worked, applies to matching branches only.
  AREA_SPECIFIC
}

enum HolidayScope {
  /// Applies to all employees regardless of branch.
  COMPANY_WIDE
  /// Applies only to employees in the listed branch IDs.
  BRANCH_SPECIFIC
}

enum PremiumMultiplierKey {
  OT
  NSD
  REST_DAY
  REST_DAY_OT
  SPECIAL_HOLIDAY
  SPECIAL_HOLIDAY_OT
  SPECIAL_HOLIDAY_REST_DAY
  SPECIAL_HOLIDAY_REST_DAY_OT
  REGULAR_HOLIDAY
  REGULAR_HOLIDAY_OT
  REGULAR_HOLIDAY_REST_DAY
  REGULAR_HOLIDAY_REST_DAY_OT
  DOUBLE_HOLIDAY
  DOUBLE_HOLIDAY_OT
  DOUBLE_HOLIDAY_REST_DAY
  DOUBLE_HOLIDAY_REST_DAY_OT
  HAZARD
  NO_WORK_REGULAR_HOLIDAY
}

// =============================================================================
// TENANT (SaaS customer)
// =============================================================================

model Tenant {
  id          String  @id @default(cuid())
  name        String
  tradeName   String?
  companyCode String? @unique
  subdomain   String? @unique
  industry    String?

  // Encrypted at app layer
  tinNumber        String? @unique
  /// PAY-201: BIR Revenue District Office code of the withholding agent (e.g. "043", "17A").
  rdoCode          String?
  sssNumber        String?
  philhealthNumber String?
  pagibigNumber    String?

  address      String?
  city         String?
  province     String?
  zipCode      String?
  country      String  @default("Philippines")
  contactEmail String?
  contactPhone String?
  logoUrl      String?
  /// R2 object key for an uploaded company logo (tenants/{tenantId}/branding/...).
  /// Takes precedence over logoUrl, which remains for externally-hosted logos.
  logoKey      String?

  // Central Portal segmentation / account management
  /// Geographic region for platform segmentation (e.g. "NCR", "Calabarzon").
  region      String?
  /// Primary contact / account owner name shown in the Central Portal.
  ownerName   String?
  /// Manual account-health override (0–100). Null → auto-computed heuristic at read time.
  healthScore Int?
  /// FK to the User who is the designated Super Admin / primary owner of this tenant.
  /// Set on creation; transferable by the owner or Central Portal admins.
  ownerUserId String?

  // Employee ID format — controls how auto-generated employeeNumbers look.
  empIdPrefix      String  @default("EMP-")
  empIdIncludeYear Boolean @default(false)
  empIdPadding     Int     @default(4)
  empIdSuffix      String  @default("")
  /// Next sequence number to claim atomically on employee creation.
  empIdNextSeq     Int     @default(1)
  /// Calendar year of the current sequence (used to reset seq to 1 each year when empIdIncludeYear=true).
  empIdSeqYear     Int?

  // Subscription
  subscriptionTier   SubscriptionTier   @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  billingEmail       String?

  /// Per-tenant feature toggles (e.g. {"ai_assistant": true, "ats": false}).
  featureFlags Json @default("{}")

  // Payroll defaults (§9 of blueprint)
  payrollCycle               PayFrequency            @default(SEMI_MONTHLY)
  /// For Semi-Monthly/Monthly: day of month (1–28). For Weekly/Bi-Weekly: ISO weekday (1=Mon … 7=Sun).
  payDay1                    Int?
  /// Second pay day — only used for Semi-Monthly (e.g. 1 & 15 → payDay1=1, payDay2=15).
  payDay2                    Int?
  workingDaysDenominator     Int                     @default(261)
  /// PAY-133: new companies deduct SSS/PhilHealth/Pag-IBIG on the FIRST payday
  /// of the month (Mark, 16 Nov 2026). Existing companies keep their setting.
  statutoryCutoffRule        StatutoryCutoffRule     @default(FIRST_CUTOFF)
  /// PAY-198: lates and undertime reduce the 13th month base (default). Off:
  /// the company does not deduct them from the 13th month.
  thirteenthMonthDeductLates Boolean                 @default(true)
  /// PAY-143: per contribution, whether its base adds other earnings to basic
  /// pay. "Earnings": pay components ticked for that base. "Premiums":
  /// overtime, night differential, holiday and rest day pay. Off by default.
  sssIncludeEarnings         Boolean                 @default(false)
  sssIncludePremiums         Boolean                 @default(false)
  philhealthIncludeEarnings  Boolean                 @default(false)
  philhealthIncludePremiums  Boolean                 @default(false)
  pagibigIncludeEarnings     Boolean                 @default(false)
  pagibigIncludePremiums     Boolean                 @default(false)
  thirteenthMonthBasis       ThirteenthMonthBasis    @default(STRICT_DOLE)
  /// Payroll safeguard: max % of monthly gross that statutory + loan/recurring
  /// deductions may consume. New loans that would breach this are blocked
  /// ("no negative pay" policy). Default 50.
  maxDeductionPctOfGross     Int                     @default(50)
  /// PAY-146: an unpaid meal break is deducted only on days whose span (first in to last out) is longer than this. Default 300 (5 hours).
  breakDeductAfterMinutes    Int                     @default(300)
  /// "No negative pay" run-time floor: in REGULAR/YEAR_END runs, loan
  /// installments are deferred (carried in the loan balance) so net pay never
  /// drops below zero. FINAL_PAY is exempt by default — terminal charges
  /// against a separating employee's last pay may legitimately make it
  /// negative. Set false to also floor FINAL_PAY. Default true.
  allowNegativeFinalPay      Boolean                 @default(true)
  /// How final pay settles the year's withholding tax (Mark, 21 Nov 2026).
  finalPayTaxMethod          FinalPayTaxMethod       @default(REFUND_AND_WITHHOLD_FINAL)
  /// PAY-172 (Mark, 19 Nov 2026): strict DTR policy. On: an employee who needs a
  /// time clock and whose DTR for the run's cutoff is not fully approved is held
  /// out of the run (no pay until it is approved; DTR approval is one cutoff,
  /// not per day). Off (default): days without an approved DTR count as absent.
  strictDtrPolicy            Boolean                 @default(false)
  defaultDtrApproverId       String?
  /// Night-shift differential window ("HH:MM"). NSD is always computed (cannot
  /// be turned off); only the window is configurable. The premium multiplier
  /// lives in PremiumRateConfig (key NSD, DOLE default 0.10).
  nsdWindowStart             String                  @default("22:00")
  nsdWindowEnd               String                  @default("06:00")
  /// IANA timezone for company-wide timekeeping (default derived from country
  /// at creation). Anchors business-day boundaries, the NSD window and the
  /// statutory month-end for this tenant.
  timezone                   String                  @default("Asia/Manila")
  /// Whether DTR/attendance follows the company timezone or each employee's own.
  timekeepingTimezoneMode    TimekeepingTimezoneMode @default(COMPANY)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  users                   User[]
  roles                   Role[]
  departments             Department[]
  branches                Branch[]
  workLocations           WorkLocation[]
  positions               Position[]
  jobLevels               JobLevel[]
  jobTypes                JobType[]
  jobStatuses             JobStatus[]
  employees               Employee[]
  statutoryIds            StatutoryId[]
  employeeSalaries        EmployeeSalary[]
  employeeMovements       EmployeeMovement[]
  placements              Placement[]
  employmentTerms         EmploymentTerm[]
  incidentReports         IncidentReport[]
  assets                  Asset[]
  assetAssignments        AssetAssignment[]
  employeeDocuments       EmployeeDocument[]
  employeeEducation       EmployeeEducation[]
  employeeWorkExperiences EmployeeWorkExperience[]
  employeeTrainings       EmployeeTraining[]
  geofences               Geofence[]
  kiosks                  Kiosk[]
  leaveTypes              LeaveType[]
  leaveEntitlements       LeaveEntitlement[]
  approvalWorkflows       ApprovalWorkflow[]
  leaveTransactions       LeaveTransaction[]
  dtrApprovalConfig       DTRApprovalConfig?
  auditLogs               AuditLog[]
  consentRecords          ConsentRecord[]
  aiUsage                 AiUsage[]
  statutoryRules          StatutoryRule[]
  payComponents           PayComponent[]
  employeePayComponents   EmployeePayComponent[]
  periodInputs            PeriodInput[]
  loans                   Loan[]
  payrollBooks            PayrollBook[]
  paySchedules            PaySchedule[]
  ytdOpenings             EmployeeYtdOpening[]
  payrollSheets           PayrollSheet[]
  payrollAdjustments      PayrollAdjustment[]
  shiftSchedules          ShiftSchedule[]
  shiftAssignments        EmployeeShiftAssignment[]
  dtrRecords              DTRRecord[]
  attendanceLogs          AttendanceLog[]
  expenseClaims           ExpenseClaim[]
  essSessions             EssSession[]
  essWebAuthnCredentials  EssWebAuthnCredential[]
  essInvites              EssInvite[]
  essPasswordResets       EssPasswordReset[]
  otApplications          OTApplication[]
  undertimeRequests       UndertimeRequest[]
  profileUpdateRequests   ProfileUpdateRequest[]
  dtrSubmissions          DTRSubmission[]
  dtrAuditLogs            DTRAuditLog[]

  defaultDtrApprover Employee?      @relation("TenantDefaultDtrApprover", fields: [defaultDtrApproverId], references: [id])
  owner              User?          @relation("TenantOwner", fields: [ownerUserId], references: [id])
  orgRoles           OrgRole[]
  approvalSteps      ApprovalStep[]

  // Billing
  subscription TenantSubscription?
  invoices     Invoice[]
  payments     Payment[]

  jobPostings             JobPosting[]
  applicants              Applicant[]
  applicantNotes          ApplicantNote[]
  holidays                Holiday[]
  premiumRateConfigs      PremiumRateConfig[]
  announcements           Announcement[]
  supportTickets          SupportTicket[]
  subscriptionEvents      SubscriptionEvent[]
  centralAuditEvents      CentralAuditEvent[]
  documentSeries          DocumentSeries[]
  payrollCorrections      PayrollCorrection[]
  clearanceTemplateItems  ClearanceTemplateItem[]
  offboardingCases        OffboardingCase[]
  clearanceItems          ClearanceItem[]
  lookupItems             LookupItem[]
  documentTemplates       DocumentTemplate[]
  leaveEarningPolicies    LeaveEarningPolicy[]
  leaveSchedules          LeaveSchedule[]
  discussionThreads       DiscussionThread[]
  discussionComments      DiscussionComment[]
  sharedDocuments         SharedDocument[]
  salaryAdjustmentBatches SalaryAdjustmentBatch[]
  causelessNotes          CauselessNote[]
  documentRequests        DocumentRequest[]

  @@index([deletedAt])
}

/// Company-wide announcement surfaced in the ESS app (Home feed + detail).
/// Authored by tenant HR/admins; read-only for employees.
model Announcement {
  id       String  @id @default(cuid())
  tenantId String
  title    String
  body     String  @db.Text
  /// Free-text tag shown as a chip, e.g. "Payroll", "Benefits", "General".
  category String?

  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdByUserId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isPublished, publishedAt])
  @@index([deletedAt])
}

// =============================================================================
// USERS & RBAC
// =============================================================================

model User {
  id                 String    @id @default(cuid())
  tenantId           String? // NULL for SUPER_ADMIN users
  email              String
  passwordHash       String
  /// Unit 0.15 Am 2 (ruling B8): sessions signed in before this instant are
  /// rejected. Set when the password changes or is reset.
  sessionsValidAfter DateTime?
  /// Unit 0.15 Am 4: wrong passwords in a row since the last success or lock.
  /// Five lock dashboard sign-in for 15 minutes; a reset link unlocks at once.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  firstName          String
  lastName           String
  jobTitle           String? // Central Portal administrator title / position (optional)

  systemRole SystemRole @default(TENANT_USER)
  roleId     String?

  // Central Portal role (only meaningful when tenantId IS NULL / systemRole = SUPER_ADMIN)
  centralRoleId String?

  // Authenticize (OIDC IdP) subject linked to this account, set on first SSO
  // sign-in. Not globally unique — one person may map to accounts in several
  // tenants — but unique within a tenant (see @@unique below).
  authenticizeUserId String?

  essPinHash String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant                Tenant?        @relation(fields: [tenantId], references: [id])
  ownedTenants          Tenant[]       @relation("TenantOwner")
  assignedRole          Role?          @relation(fields: [roleId], references: [id])
  centralRole           CentralRole?   @relation(fields: [centralRoleId], references: [id])
  employee              Employee?
  approvedExpenseClaims ExpenseClaim[] @relation("ExpenseClaimApprover")

  createdJobPostings     JobPosting[]
  assignedApplicants     Applicant[]             @relation("ApplicantAssignedTo")
  applicantNotes         ApplicantNote[]
  passwordResetTokens    PasswordResetToken[]
  assignedTickets        SupportTicket[]         @relation("TicketAgent")
  centralAuditEvents     CentralAuditEvent[]     @relation("CentralAuditActor")
  clearanceTemplateItems ClearanceTemplateItem[] @relation("ClearanceTemplateSignatory")
  clearanceItems         ClearanceItem[]         @relation("ClearanceItemSignatory")

  @@unique([tenantId, email])
  @@unique([tenantId, authenticizeUserId])
  @@index([tenantId])
  @@index([roleId])
  @@index([centralRoleId])
  @@index([deletedAt])
}

/// Unit 0.15 Am 2 (ruling B7): what a PasswordResetToken row is for. An
/// INVITE sets a new account's first password (and, for Central admins,
/// activates it); a RESET only changes the password of an ACTIVE account.
enum UserLinkPurpose {
  INVITE
  RESET
}

model PasswordResetToken {
  id        String          @id @default(cuid())
  userId    String
  purpose   UserLinkPurpose @default(RESET)
  tokenHash String          @unique // SHA-256 hex of the raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
}

model Permission {
  id     String           @id @default(cuid())
  module PermissionModule
  action PermissionAction
  label  String

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId           String
  permissionId     String
  departmentScoped Boolean @default(false)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// =============================================================================
// CENTRAL PORTAL RBAC (SUPER_ADMIN, tenantId = NULL)
// Mirrors the tenant Role/Permission/RolePermission trio but is global rather
// than tenant-scoped. The built-in "Super Admin" role (isSystem = true) is
// seeded with every permission and cannot be deleted.
// =============================================================================

model CentralRole {
  id          String  @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions CentralRolePermission[]
  users       User[]

  @@index([deletedAt])
}

model CentralPermission {
  id     String        @id @default(cuid())
  module CentralModule
  action CentralAction
  label  String

  roles CentralRolePermission[]

  @@unique([module, action])
}

model CentralRolePermission {
  centralRoleId       String
  centralPermissionId String

  role       CentralRole       @relation(fields: [centralRoleId], references: [id], onDelete: Cascade)
  permission CentralPermission @relation(fields: [centralPermissionId], references: [id], onDelete: Cascade)

  @@id([centralRoleId, centralPermissionId])
}

// =============================================================================
// ORG STRUCTURE
// =============================================================================

model WorkLocation {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  /// PSGC / DOLE region code — drives minimum-wage lookup (e.g. "NCR", "CAR", "07").
  region   String
  address  String?
  city     String?
  province String?
  zipCode  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  branches Branch[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
}

model Department {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  headId      String?

  /// Wave E3 (PAY-215): the Leave Planner warns when more are off on a day.
  maxOnLeave Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  head        Employee?    @relation("DepartmentHead", fields: [headId], references: [id])
  employees   Employee[]
  positions   Position[]
  jobPostings JobPosting[]
  placements  Placement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([headId])
  @@index([deletedAt])
}

model Branch {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  workLocationId String?
  address        String?
  city           String?
  province       String?
  zipCode        String?
  isHeadOffice   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])
  employees    Employee[]
  geofences    Geofence[]
  kiosks       Kiosk[]
  jobPostings  JobPosting[]
  placements   Placement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([workLocationId])
  @@index([deletedAt])
}

model Position {
  id           String  @id @default(cuid())
  tenantId     String
  title        String
  levelId      String?
  description  String?
  departmentId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant               Tenant       @relation(fields: [tenantId], references: [id])
  level                JobLevel?    @relation("PositionLevel", fields: [levelId], references: [id], onDelete: SetNull)
  department           Department?  @relation(fields: [departmentId], references: [id])
  employees            Employee[]
  jobPostings          JobPosting[]
  placements           Placement[]
  reportsFromEmployees Employee[]   @relation("EmployeeReportsToPosition")

  @@unique([tenantId, title])
  @@index([tenantId])
  @@index([levelId])
  @@index([departmentId])
  @@index([deletedAt])
}

model JobLevel {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  rank        Int     @default(0)
  description String?

  defaultWorkflowId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  employees       Employee[]
  placements      Placement[]
  positions       Position[]         @relation("PositionLevel")
  movementsTo     EmployeeMovement[] @relation("MovementToLevel")
  movementsFrom   EmployeeMovement[] @relation("MovementFromLevel")
  defaultWorkflow ApprovalWorkflow?  @relation("LevelDefaultWorkflow", fields: [defaultWorkflowId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
  @@index([defaultWorkflowId])
}

// Org-wide singleton role assignments (hr_manager, ceo).
// Per-employee roles (supervisor, line_manager) live on Employee directly.
// Department head lives on Department.headId.
model OrgRole {
  id         String @id @default(cuid())
  tenantId   String
  roleKey    String
  employeeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation("OrgRoleEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleKey])
  @@index([tenantId])
  @@index([employeeId])
}

model JobType {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  deletedAt   DateTime?
  /// Wave F1 (PAY-216): employees of this job type work in the field.
  fieldWork   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  employees       Employee[]
  employmentTerms EmploymentTerm[]
  toMovements     EmployeeMovement[] @relation("MovementToJobType")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model JobStatus {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  employees       Employee[]
  employmentTerms EmploymentTerm[]
  toMovements     EmployeeMovement[] @relation("MovementToJobStatus")

  @@unique([tenantId, name])
  @@index([tenantId])
}

// =============================================================================
// CORE HRIS — Employee
// =============================================================================

model Employee {
  id       String  @id @default(cuid())
  tenantId String
  userId   String? @unique

  // Personal
  employeeNumber String
  firstName      String
  middleName     String?
  lastName       String
  suffix         String?
  preferredName  String?
  birthDate      DateTime?
  gender         Gender?
  civilStatus    CivilStatus?
  nationality    String?      @default("Filipino")
  /// R2 object key for an uploaded profile photo (tenants/{tenantId}/employee-photos/...).
  photoKey       String?

  // Contact
  personalEmail String?
  workEmail     String?
  mobileNumber  String?
  phoneNumber   String?

  // Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  zipCode      String?
  /// PAY-201: BIR Revenue District Office code where the employee is registered (2316 Item 5).
  rdoCode      String?
  region       String?

  // Employment
  departmentId       String?
  branchId           String?
  positionId         String?
  /// Free-text fallback when no Position row is assigned (legacy data).
  jobTitle           String?
  levelId            String?
  employmentStatus   EmploymentStatus @default(PROBATIONARY)
  employmentType     EmploymentType   @default(FULL_TIME)
  hireDate           DateTime
  regularizationDate DateTime?
  resignationDate    DateTime?
  lastWorkingDate    DateTime?
  endOfContractDate  DateTime?

  // Reporting chain (drives DTR + movement approval routing)
  immediateSupervisorId String?
  managerId             String?

  // Payroll
  payFrequency           PayFrequency @default(SEMI_MONTHLY)
  salaryType             SalaryType   @default(MONTHLY)
  standardWorkHours      Decimal      @default(8) @db.Decimal(4, 2)
  standardWorkDays       Decimal      @default(22) @db.Decimal(4, 2)
  /// Unit 1.8 (D-S4): working days a year used to turn a monthly or weekly
  /// salary into a daily equivalent (unpaid-leave deductions, OT, holiday and
  /// undertime rates). 261 for a five-day week, 313 for a six-day week. Set
  /// from the work schedule when the employee is created; an explicit field
  /// after that, never recomputed from the schedule. Null: the tenant's
  /// workingDaysDenominator applies. Each payroll sheet snapshots the value used.
  workingDaysDenominator Int?
  /// Optional IANA timezone override; used only when the tenant's
  /// timekeepingTimezoneMode is EMPLOYEE (otherwise inherits company tz).
  timezone               String?

  // Tax
  taxClassification          TaxClassification @default(REGULAR)
  /// For MWE: portion of basic pay considered non-taxable (centavos).
  nontaxableBasicAmountCents BigInt            @default(0)

  // ESS
  /// The employee's 6-digit ESS PIN (bcrypt), the default sign-in. Set ONLY by
  /// the employee, through their invitation or a reset link; HR never sets or
  /// sees it (unit 0.15 Am 3, Mark's ruling of 10 Nov).
  essPin                         String? // hashed at app layer
  essPasswordHash                String? // optional ESS password (bcrypt), set by the employee
  /// Where ESS invitation and reset links go: the personal email at hiring,
  /// switchable to the work email later (unit 0.15 Am 3).
  essEmailChoice                 EssEmailChoice  @default(PERSONAL)
  /// Wrong PIN or password attempts since the last success or lock. Five in a
  /// row lock ESS sign-in for 15 minutes; a reset link unlocks at once.
  essFailedAttempts              Int             @default(0)
  essLockedUntil                 DateTime?
  kioskPinHash                   String?
  /// ESS portal access. Employees do NOT get access on creation — HR must
  /// grant (activate) it. Login is blocked unless INVITED or ACTIVE.
  essAccessStatus                EssAccessStatus @default(NOT_INVITED)
  essInvitedAt                   DateTime?
  essActivatedAt                 DateTime?
  essInvitedByUserId             String?
  essLastLoginAt                 DateTime?
  /// Scheduled ESS deactivation. When essDeactivateAt passes, access is revoked
  /// (auth gate denies immediately; an hourly sweep flips status → DISABLED and
  /// ends live sessions). Reason is required when scheduling/deactivating.
  essDeactivateAt                DateTime?
  essDeactivateReason            String?
  essDeactivateScheduledByUserId String?
  qrBadgeCode                    String?

  // Bank (encrypted at app layer)
  /// Wave A1 (PAY-208): the company's Bank list item; its name is copied to bankName.
  bankId            String?
  bankItem          LookupItem? @relation("EmployeeBank", fields: [bankId], references: [id], onDelete: SetNull)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?

  // Extended personal fields
  nationalId                   String?
  passportNumber               String?
  ethnicity                    String?
  religion                     String?
  /// Wave A1 (PAY-208): when HR noted the employee's consent to record ethnicity and religion.
  sensitiveDataConsentAt       DateTime?
  sensitiveDataConsentByUserId String?
  allowProfileUpdate           Boolean   @default(false)
  needsTimeClock               Boolean   @default(true)
  /// Skip geofence enforcement for this employee's punches (e.g. field staff,
  /// or employees whose time clock is off). When true, punches are never
  /// flagged outsideGeofence.
  geofenceExempt               Boolean   @default(false)
  /// Wave F1 (PAY-216): works in the field; punches are checked against every
  /// fence that applies (also set per job type).
  fieldWork                    Boolean   @default(false)
  /// Employee receives full pay for every scheduled workday without needing
  /// time-clock punches or DTR records (e.g. executives, C-level). Leaves and
  /// public holidays still apply. Only HR/Payroll Admin may enable this.
  attendanceExempt             Boolean   @default(false)

  // Extended employment fields
  placementEffectiveDate DateTime?
  jobTypeId              String?
  jobStatusId            String?
  shiftScheduleId        String?
  // Org-chart: when set, this employee reports to a (vacant) position/role
  // rather than to a specific person. Resolved to the incumbent if filled.
  reportsToPositionId    String?
  termEffectiveDate      DateTime?
  contractStartDate      DateTime?
  contractEndDate        DateTime?

  // Salary metadata
  salaryEffectiveDate  DateTime?
  currency             String?   @default("PHP")
  nextSalaryReviewDate DateTime?
  payMethod            String?

  // Extended contact
  blogUrl     String?
  officePhone String?
  housePhone  String?
  postcode    String?
  country     String? @default("Philippines")

  // Health
  heightCm  Decimal? @db.Decimal(5, 1)
  weightKg  Decimal? @db.Decimal(5, 1)
  bloodType String?
  visionL   String?
  visionR   String?
  hearingL  String?
  hearingR  String?
  handL     String?
  handR     String?
  legL      String?
  legR      String?

  // Family / spouse
  spouseFirstName   String?
  spouseMiddleName  String?
  spouseLastName    String?
  spouseBirthDate   DateTime?
  spouseNationality String?
  spouseNationalId  String?
  spousePassport    String?
  spouseEthnicity   String?
  spouseReligion    String?
  spouseWorking     Boolean?
  numberOfChildren  Int?      @default(0)

  // Directory & privacy
  directoryRole    String? @default("Employee")
  pvEmail          String? @default("Employee")
  pvBlog           String? @default("Employee")
  pvOfficePhone    String? @default("Employee")
  pvMobilePhone    String? @default("Employee")
  pvHousePhone     String? @default("Not Accessible")
  pvAddress        String? @default("Not Accessible")
  pvEmergency      String? @default("Manager")
  pvBirthday       String? @default("Employee")
  pvFamilyBirthday String? @default("Employee")
  pvAnniversary    String? @default("Employee")

  // Others
  remark String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  user              User?          @relation(fields: [userId], references: [id])
  department        Department?    @relation(fields: [departmentId], references: [id])
  branch            Branch?        @relation(fields: [branchId], references: [id])
  position          Position?      @relation(fields: [positionId], references: [id])
  level             JobLevel?      @relation(fields: [levelId], references: [id])
  jobType           JobType?       @relation(fields: [jobTypeId], references: [id])
  jobStatus         JobStatus?     @relation(fields: [jobStatusId], references: [id])
  shiftSchedule     ShiftSchedule? @relation(fields: [shiftScheduleId], references: [id])
  reportsToPosition Position?      @relation("EmployeeReportsToPosition", fields: [reportsToPositionId], references: [id])

  immediateSupervisor Employee?  @relation("EmployeeSupervisor", fields: [immediateSupervisorId], references: [id])
  supervisorOf        Employee[] @relation("EmployeeSupervisor")
  manager             Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  managerOf           Employee[] @relation("EmployeeManager")

  headOfDepartments Department[]   @relation("DepartmentHead")
  orgRoles          OrgRole[]      @relation("OrgRoleEmployee")
  approvalSteps     ApprovalStep[] @relation("ApprovalStepApprover")

  statutoryIds            StatutoryId[]
  salaryHistory           EmployeeSalary[]
  movements               EmployeeMovement[]
  placements              Placement[]
  lineManaged             Placement[]               @relation("PlacementLineManager")
  supervisedPlacements    Placement[]               @relation("PlacementSupervisor")
  employmentTerms         EmploymentTerm[]
  incidentReports         IncidentReport[]
  assetAssignments        AssetAssignment[]
  documents               EmployeeDocument[]
  educationRecords        EmployeeEducation[]
  workExperiences         EmployeeWorkExperience[]
  trainings               EmployeeTraining[]
  leaveBalances           LeaveBalance[]
  leaveTransactions       LeaveTransaction[]
  leaveEntitlements       LeaveEntitlement[]
  consentRecords          ConsentRecord[]
  payComponentAssignments EmployeePayComponent[]
  periodInputs            PeriodInput[]
  loans                   Loan[]
  ytdOpenings             EmployeeYtdOpening[]
  payrollSheets           PayrollSheet[]
  payrollAdjustments      PayrollAdjustment[]
  shiftAssignments        EmployeeShiftAssignment[]
  dtrRecords              DTRRecord[]
  expenseClaims           ExpenseClaim[]
  essSessions             EssSession[]
  essWebAuthnCredentials  EssWebAuthnCredential[]
  essInvites              EssInvite[]
  essPasswordResets       EssPasswordReset[]
  otApplications          OTApplication[]
  undertimeRequests       UndertimeRequest[]
  profileUpdateRequests   ProfileUpdateRequest[]
  attendanceLogs          AttendanceLog[]
  dtrSubmissions          DTRSubmission[]           @relation("DTRSubmissionEmployee")
  supervisedSubmissions   DTRSubmission[]           @relation("DTRSubmissionSupervisor")
  managedSubmissions      DTRSubmission[]           @relation("DTRSubmissionManager")

  defaultDtrApproverFor Tenant[]            @relation("TenantDefaultDtrApprover")
  hiredFromApplicant    Applicant?
  payrollCorrections    PayrollCorrection[]
  offboardingCases      OffboardingCase[]

  documentRequests      DocumentRequest[]
  salaryAdjustmentLines SalaryAdjustmentLine[]
  causelessNotes        CauselessNote[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, qrBadgeCode])
  @@index([tenantId])
  @@index([tenantId, employmentStatus])
  @@index([departmentId])
  @@index([branchId])
  @@index([positionId])
  @@index([levelId])
  @@index([jobTypeId])
  @@index([jobStatusId])
  @@index([reportsToPositionId])
  @@index([immediateSupervisorId])
  @@index([managerId])
  @@index([deletedAt])
}

// =============================================================================
// STATUTORY IDs — normalized, one row per ID type
// Number value is encrypted at app layer.
// =============================================================================

model StatutoryId {
  id         String          @id @default(cuid())
  tenantId   String
  employeeId String
  type       StatutoryIdType
  /// Encrypted at app layer (AES-256-GCM) — never query by raw value.
  number     String
  /// HMAC-SHA256 of the plaintext number using HMAC_KEY.
  /// Used for duplicate-detection without exposing ciphertext.
  numberHmac String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, type])
  @@index([tenantId])
  @@index([type, numberHmac])
}

// =============================================================================
// EMPLOYEE DOCUMENTS (R2-backed)
// =============================================================================

model EmployeeDocument {
  id         String @id @default(cuid())
  employeeId String
  tenantId   String

  category    DocumentCategory
  /// Wave A4 (PAY-211): the company's Document Categories item.
  categoryId  String?
  title       String
  description String?
  /// Wave A4: required when the category has an expiry date (IDs, permits, clearances).
  expiresAt   DateTime?

  storageKey String
  fileName   String
  mimeType   String
  fileSize   Int

  isConfidential Boolean @default(false)

  uploadedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  employee     Employee    @relation(fields: [employeeId], references: [id])
  categoryItem LookupItem? @relation("DocumentCategoryItem", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([category])
  @@index([deletedAt])
}

// =============================================================================
// EMPLOYEE BACKGROUND — Education, Work Experience, Training
// Repeatable per-employee history records (an employee has many of each).
// Tenant-scoped (RLS via app.current_tenant_id). Soft-deleted.
// =============================================================================

enum EducationLevel {
  ELEMENTARY
  HIGH_SCHOOL
  SENIOR_HIGH
  VOCATIONAL
  COLLEGE
  MASTERS
  DOCTORATE
  OTHER
}

/// A school/degree entry in an employee's educational background.
model EmployeeEducation {
  id         String @id @default(cuid())
  employeeId String
  tenantId   String

  level        EducationLevel?
  school       String
  degree       String?
  fieldOfStudy String?
  /// Calendar years (e.g. 2014, 2018). Either may be null (ongoing/unknown).
  startYear    Int?
  endYear      Int?
  honors       String?
  notes        String?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([deletedAt])
}

/// A prior employment record in an employee's work history.
model EmployeeWorkExperience {
  id         String @id @default(cuid())
  employeeId String
  tenantId   String

  companyName      String
  position         String
  startDate        DateTime?
  /// null = present / ongoing.
  endDate          DateTime?
  location         String?
  description      String?
  reasonForLeaving String?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([deletedAt])
}

/// A training / seminar / certification completed by an employee. An optional
/// certificate file can be uploaded to R2 (same presigned flow as 201 files).
model EmployeeTraining {
  id         String @id @default(cuid())
  employeeId String
  tenantId   String

  title               String
  provider            String?
  /// Wave A4 (PAY-211): the company's Courses and Trainers items.
  courseId            String?
  trainerId           String?
  trainingDate        DateTime?
  /// Training duration in whole hours.
  hours               Int?
  /// Optional uploaded certificate (R2 object key + metadata).
  certificateKey      String?
  certificateFileName String?
  certificateMimeType String?
  certificateFileSize Int?
  /// For certifications that expire (e.g. first-aid, safety).
  expiresAt           DateTime?
  notes               String?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])
  courseItem  LookupItem? @relation("TrainingCourseItem", fields: [courseId], references: [id], onDelete: SetNull)
  trainerItem LookupItem? @relation("TrainingTrainerItem", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([deletedAt])
}

// =============================================================================
// SALARY HISTORY
// All monetary amounts stored as BigInt centavos.
// =============================================================================

/// DEPRECATED — salary now lives on EmploymentTerm (merged). This table is no
/// longer written or read by application code; it is retained only to preserve
/// historical rows and to allow rollback. A follow-up migration may drop it
/// once the merge is verified in production.
model EmployeeSalary {
  id         String @id @default(cuid())
  employeeId String
  tenantId   String

  /// Basic salary for the period implied by salaryType, in centavos.
  basicSalaryCents BigInt
  salaryType       SalaryType

  effectiveDate DateTime
  endDate       DateTime?
  reason        String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveDate])
  @@index([tenantId])
}

// =============================================================================
// MOVEMENT FORMS
// =============================================================================

model EmployeeMovement {
  id           String       @id @default(cuid())
  tenantId     String
  employeeId   String
  movementType MovementType

  fromDepartmentId     String?
  toDepartmentId       String?
  fromBranchId         String?
  toBranchId           String?
  fromPositionId       String?
  toPositionId         String?
  fromJobTitle         String?
  toJobTitle           String?
  fromLevelId          String?
  toLevelId            String?
  fromBasicSalaryCents BigInt?
  toBasicSalaryCents   BigInt?
  fromSalaryType       SalaryType?
  toSalaryType         SalaryType?
  fromStatus           EmploymentStatus?
  toStatus             EmploymentStatus?

  // Placement-scope fields (used by PLACEMENT_CHANGE and COMBINED_CHANGE)
  fromLineManagerId         String?
  toLineManagerId           String?
  fromImmediateSupervisorId String?
  toImmediateSupervisorId   String?
  // Placement-scope: approval workflow assignment
  toWorkflowId              String?
  // Terms-scope fields (used by TERMS_CHANGE and COMBINED_CHANGE)
  toJobTypeId               String?
  toJobStatusId             String?
  toShiftScheduleId         String?
  toTermStart               DateTime?
  toNextReviewDate          DateTime?

  effectiveDate DateTime
  reason        String?
  notes         String?
  documentUrl   String?

  approvalStatus   ApprovalStatus @default(PENDING)
