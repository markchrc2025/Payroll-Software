  /// Snapshot of changes — typically { before: {...}, after: {...} }.
  changes     Json?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([actorUserId])
